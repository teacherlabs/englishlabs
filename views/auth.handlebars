<main class="auth-landing">
  <video
    class="auth-landing-video"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  >
    <source src="/backgrounds/mainpage.mp4" type="video/mp4" />
  </video>
  <div class="auth-landing-grid" aria-hidden="true"></div>
  <section class="auth-landing-content">
    <p class="eyebrow">English Labs</p>
    <h1>Welcome to Melisa's dungeon</h1>
    <p>Welcome to her space. Learn your English in this place. Fix your mistakes
      one by one. Melisa decides when you are done.</p>
    <div class="auth-landing-actions">
      <a class="auth-primary-button" href="/login">Log in</a>
      <a class="auth-secondary-button" href="/signup">Sign up</a>
    </div>
  </section>
</main>

<script>
  (function initializeLandingGrid() { var grid =
  document.querySelector(".auth-landing-grid"); if (!grid) return; var
  resizeFrame; var fadeTimers = new WeakMap(); function buildGrid() { var
  cellSize = 34; var columns = Math.ceil(window.innerWidth / cellSize); var rows
  = Math.ceil(window.innerHeight / cellSize);
  grid.style.setProperty("--grid-columns", columns); grid.replaceChildren(); for
  (var index = 0; index < columns * rows; index += 1) { var cell =
  document.createElement("span"); cell.className = "auth-landing-grid-cell";
  cell.addEventListener("pointerenter", function handlePointerEnter() {
  clearTimeout(fadeTimers.get(this)); this.classList.remove("is-fading");
  this.classList.add("is-active"); }); cell.addEventListener("pointerleave",
  function handlePointerLeave() { var currentCell = this;
  currentCell.classList.remove("is-active");
  currentCell.classList.add("is-fading"); var timer = setTimeout(function
  clearFade() { currentCell.classList.remove("is-fading"); }, 800);
  fadeTimers.set(currentCell, timer); }); grid.append(cell); } } buildGrid();
  window.addEventListener("resize", function handleResize() {
  cancelAnimationFrame(resizeFrame); resizeFrame =
  requestAnimationFrame(buildGrid); }); })();
</script>