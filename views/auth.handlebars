<main class="auth-landing">
  <video
    class="auth-landing-video"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  >
    <source src="/backgrounds/mainpage.mp4" type="video/mp4" />
  </video>
  <section class="auth-landing-content">
    <p class="eyebrow">English Labs</p>
    <h1>Welcome to Melisa's dungeon</h1>
    <p>Welcome to her space. Learn your English in this place. Fix your mistakes
      one by one. Melisa decides when you are done.</p>
    <div class="auth-landing-actions">
      <a class="auth-primary-button" href="/login">Log in</a>
      <a class="auth-secondary-button" href="/signup">Sign up</a>
    </div>
  </section>
</main>