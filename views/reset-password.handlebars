<main class="account-page">
  <section class="account-card">
    <p class="eyebrow">English Labs / Account</p>
    <h1>Choose a new password</h1>
    <p>Use at least 8 characters for your new password.</p>
    <form action="/reset-password/{{token}}" method="post" class="account-form">
      <label for="password">New password</label>
      <input
        id="password"
        name="password"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
        placeholder="New password"
      />
      <label for="confirmPassword">Confirm new password</label>
      <input
        id="confirmPassword"
        name="confirmPassword"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
        placeholder="Repeat new password"
      />
      <button class="practice-button" type="submit">Reset password</button>
    </form>
    {{#if error}}<p class="account-error">{{error}}</p>{{/if}}
    <a class="account-link" href="/login">Back to log in</a>
  </section>
</main>