<main class="account-page">
  <section class="account-card">
    <p class="eyebrow">English Labs / Account</p>
    <h1>Create student account</h1>
    <p>Save your scores and keep your grammar goals in one place.</p>
    <form action="/signup" method="post" class="account-form">
      <div class="signup-name-fields">
        <div class="signup-field">
          <label for="fname">First name</label>
          <input
            id="fname"
            name="fname"
            required
            autocomplete="given-name"
            placeholder="First name"
          />
        </div>
        <div class="signup-field">
          <label for="lname">Last name</label>
          <input
            id="lname"
            name="lname"
            required
            autocomplete="family-name"
            placeholder="Last name"
          />
        </div>
      </div>
      <label for="username">Username</label>
      <input
        id="username"
        name="username"
        required
        autocomplete="username"
        placeholder="Choose a username"
      />
      <label for="email">Email address</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
      <label for="goal">Learning goal</label>
      <input
        id="goal"
        name="goal"
        placeholder="For example: master verb tenses"
      />
      <label for="password">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
      />
      <label for="confirmPassword">Confirm password</label>
      <input
        id="confirmPassword"
        name="confirmPassword"
        type="password"
        required
        minlength="8"
        autocomplete="new-password"
      />
      <button class="practice-button" type="submit">Create account</button>
    </form>
    {{#if error}}<p class="account-error">{{error}}</p>{{/if}}
    <a class="account-link" href="/login">Already have an account? Log in</a>
  </section>
</main>