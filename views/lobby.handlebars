<main class="lobby-page{{#unless isAdmin}} lobby-student-page{{/unless}}{{#if isActiveSession}} lobby-active-session{{/if}}{{#unless participant}} lobby-join-page{{/unless}}" data-user-id="{{student.id}}">
  <div class="lobby-settings" data-lobby-settings>
    <button class="lobby-settings-toggle" type="button" data-lobby-settings-toggle aria-expanded="false" aria-controls="lobby-settings-menu" aria-label="Open lobby settings" title="Lobby settings">&#9881;</button>
    <div class="lobby-settings-menu" id="lobby-settings-menu" data-lobby-settings-menu hidden>
      <p class="lobby-settings-title">Room settings</p>
      <button type="button" class="lobby-settings-action" data-lobby-sound-toggle><span aria-hidden="true">&#9835;</span><span data-lobby-sound-label>Sound on</span></button>
      <a class="lobby-settings-action lobby-settings-leave" href="/">Leave lobby</a>
    </div>
  </div>
  {{#if isAdmin}}
    {{#unless room}}
      <section class="lobby-quiz-panel">
        <div class="lobby-admin-tools">
          <p class="eyebrow">Teacher control</p>
          <h1>Launch a new lobby</h1>
          <form class="lobby-form lobby-create-form" action="/lobby/create" method="post" data-room-create>
            <label for="room-title">Room name / title</label>
            <input id="room-title" name="title" placeholder="Friday English quiz" required />
            <fieldset class="lobby-mode-picker">
              <legend>Game mode</legend>
              <label><input type="radio" name="mode" value="lobby" checked /> <span>Question Game</span></label>
              <label><input type="radio" name="mode" value="quicktype" /> <span>QuickType</span></label>
            </fieldset>
            <button class="practice-button" type="submit">Launch Lobby</button>
          </form>
        </div>
      </section>
    {{/unless}}
  {{else}}
    {{#unless participant}}<section class="lobby-quiz-panel"><h1>Join a quiz</h1><form class="lobby-form" action="/lobby/join" method="post"><label for="room-code">Enter the 4-digit code</label><input id="room-code" name="code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required placeholder="1234" /><button class="practice-button" type="submit">Join room</button></form></section>{{/unless}}
  {{/if}}
  {{#if isAdmin}}{{#if room}}{{#unless isQuicktype}}
  <div class="quiz-selector-modal" data-quiz-selector hidden>
    <section class="quiz-selector-dialog" role="dialog" aria-modal="true" aria-labelledby="quiz-selector-title">
      <div class="quiz-selector-heading"><div><p class="eyebrow">Quiz library</p><h2 id="quiz-selector-title">Choose a quiz</h2></div><button type="button" class="quiz-selector-close" data-quiz-selector-close aria-label="Close quiz selector">&times;</button></div>
      <div class="quiz-selector-grid" data-quiz-selector-grid><p class="admin-live-note">Loading quizzes...</p></div>
    </section>
  </div>
  <div class="quiz-selector-modal" data-quiz-creator hidden>
    <section class="quiz-selector-dialog quiz-creator-dialog" role="dialog" aria-modal="true" aria-labelledby="quiz-creator-title">
      <div class="quiz-selector-heading"><div><p class="eyebrow">Quiz library</p><h2 id="quiz-creator-title">Create New Quiz</h2></div><button type="button" class="quiz-selector-close" data-quiz-creator-close aria-label="Close quiz creator">&times;</button></div>
      <form data-quiz-creator-form>
        <label class="quiz-creator-label" for="new-quiz-title">Quiz title</label>
        <input id="new-quiz-title" class="quiz-creator-title-input" name="title" maxlength="100" placeholder="Friday grammar challenge" required />
        <div class="quiz-creator-questions" data-quiz-creator-questions></div>
        <button type="button" class="notes-button" data-add-quiz-question>+ Add Question</button>
        <p class="quiz-selector-error" data-quiz-creator-error hidden></p>
        <button class="practice-button quiz-creator-save" type="submit">Save Quiz to Database</button>
      </form>
    </section>
  </div>
  {{/unless}}{{/if}}{{/if}}
  <section class="lobby-shell">
    {{#if isAdmin}}
      {{#if room}}
      <div class="lobby-stage-wrap teacher-lobby-stage-wrap{{#if isLeaderboardPhase}} is-intermission{{/if}}">
        <div class="lobby-character-stage">
          <canvas data-player-canvas data-room-id="{{room.id}}" data-mode="{{room.mode}}" data-player-user-id="{{student.id}}" data-player-username="{{student.username}}" data-player-admin="{{isAdmin}}" data-player-present="{{room.teacher_present}}" data-spritesheet-image="{{student.spritesheetUrl}}" width="620" height="420" tabindex="0" aria-label="Use arrow keys or WASD to move your character"></canvas>
        </div>
      <aside class="teacher-control-sidebar">
          <header class="teacher-control-header">
            <p class="eyebrow">Teacher control</p>
            <h2>{{room.title}}</h2>
            <p class="teacher-room-status">{{#if isActiveSession}}Live game{{else}}Waiting for players{{/if}}</p>
            <p class="lobby-code">Student code: <strong>{{room.code}}</strong></p>
          </header>
          <div class="lobby-teacher-actions">
            <button class="practice-button" type="button" data-choose-quiz>Choose Quiz</button><button class="notes-button" type="button" data-create-quiz>Create Quiz</button>
            <button class="practice-button" type="button" data-teacher-entrance data-entering="false">Enter Lobby</button>
            <a class="notes-button" href="/character-generator">Customize</a>
          </div>
          <section class="teacher-participants" aria-labelledby="teacher-participants-title">
            <p class="eyebrow">Present:</p>
            <h2 id="teacher-participants-title">Students in the room</h2>
            <div class="lobby-players-grid" data-lobby-players><p class="lobby-players-empty">Waiting for players to join...</p></div>
          </section>
       <div class="lobby-phase-stack" data-lobby-phase data-room-id="{{room.id}}" data-role="admin" data-mode="{{room.mode}}">
         {{#if isActiveSession}}<div class="active-room-controls"><p class="lobby-code">Student code: <strong>{{room.code}}</strong></p>{{#unless isFinished}}<form class="lobby-inline-form" action="/lobby/quit" method="post" onsubmit="return confirm('End this game and disconnect students?');"><input type="hidden" name="roomId" value="{{room.id}}" /><button class="danger-button" type="submit">End game</button></form>{{/unless}}</div>{{/if}}
          {{#if isQuicktype}}
          <section class="admin-live-quiz" data-phase-waiting{{#unless isWaiting}} hidden{{/unless}}>
            <p class="eyebrow">Teacher control</p>
            <h2>Word <span data-question-number>{{room.current_question}}</span> of {{totalQuestions}}</h2><p class="admin-live-question">Say aloud: <strong data-target-word>{{currentQuestion.target_word}}</strong></p><button type="button" class="practice-button" data-activate-word{{#unless questions}} disabled{{/unless}}>Activate word</button>
          </section>
          {{/if}}
          <section class="admin-live-quiz" data-phase-countdown hidden>
            <p class="eyebrow">Get ready</p><h2>Starting in <span data-countdown>3</span></h2>
            <p class="admin-live-question">Say aloud: <strong data-target-word>{{currentQuestion.target_word}}</strong></p>
          </section>
          <section class="admin-live-quiz" data-phase-running{{#unless isRunning}} hidden{{/unless}}>
            <p class="eyebrow">Live quiz</p>
            <h2>Question <span data-question-number>{{room.current_question}}</span> of {{totalQuestions}}</h2>
            <p class="question-timer"><span data-question-timer>30</span>s left &middot; <span data-answered-count>0</span>/<span data-total-participants>0</span> answered</p>
            <p class="admin-live-question" data-question-text>{{currentQuestion.question_text}}</p>
            {{#if isQuicktype}}<button type="button" class="practice-button" data-next-word hidden>Next word</button>{{/if}}
            {{#unless isQuicktype}}<div class="live-answer-grid admin-live-answers">
              <button type="button"><b>A</b> <span data-answer-text="a">{{currentQuestion.answer_a}}</span></button>
              <button type="button"><b>B</b> <span data-answer-text="b">{{currentQuestion.answer_b}}</span></button>
              <button type="button"><b>C</b> <span data-answer-text="c">{{currentQuestion.answer_c}}</span></button>
              <button type="button"><b>D</b> <span data-answer-text="d">{{currentQuestion.answer_d}}</span></button>
            </div>{{/unless}}
          </section>
          <section class="round-leaderboard-panel" data-phase-leaderboard{{#unless isLeaderboardPhase}} hidden{{/unless}}>
            <p class="eyebrow">Round results</p>
            {{#if isQuicktype}}<h2>Correct spelling: <span data-correct-word></span></h2>{{else}}<h2>Standings</h2>{{/if}}
            <ol class="round-leaderboard-list" data-round-leaderboard><li>Loading...</li></ol>
            <form class="lobby-inline-form" action="/lobby/next" method="post"><input type="hidden" name="roomId" value="{{room.id}}" /><button class="practice-button" type="submit" data-next-word>{{#if isQuicktype}}Next word{{else}}Next question{{/if}}</button></form>
          </section>
          <section class="final-results-panel" data-phase-finished{{#unless isFinished}} hidden{{/unless}}>
            <p class="eyebrow">Quiz complete</p>
            <h2>Final results</h2>
            <ol class="final-results-list" data-final-results><li>Loading...</li></ol>
            <form class="lobby-inline-form finished-end-game-form" action="/lobby/quit" method="post" onsubmit="return confirm('End this game and disconnect students?');"><input type="hidden" name="roomId" value="{{room.id}}" /><button class="danger-button" type="submit">End game</button></form>
          </section>
        </div>
        <footer class="teacher-control-footer">
          <div data-intermission-actions></div>
          {{#unless isQuicktype}}{{#if isWaiting}}{{#if questions}}<form class="lobby-inline-form start-game-form" action="/lobby/start" method="post"><input type="hidden" name="roomId" value="{{room.id}}" /><input type="hidden" name="mode" value="{{room.mode}}" /><button class="practice-button" type="submit">Start Game</button></form>{{/if}}{{/if}}{{/unless}}
          {{#if isActiveSession}}<form class="lobby-inline-form lobby-quit-form" action="/lobby/quit" method="post" onsubmit="return confirm('End this game and disconnect students?');"><input type="hidden" name="roomId" value="{{room.id}}" /><button class="danger-button" type="submit">Quit lobby</button></form>{{else}}<form class="lobby-inline-form lobby-quit-form" action="/lobby/quit" method="post" onsubmit="return confirm('Quit this room? Students will be disconnected.');"><input type="hidden" name="roomId" value="{{room.id}}" /><button class="danger-button" type="submit">Quit lobby</button></form>{{/if}}
        </footer>
        </aside>
      </div>
      {{/if}}
    {{else}}
      {{#if participant}}
      <div class="lobby-stage-wrap">
        <div class="lobby-student-main{{#if isQuicktype}} quicktype-lobby{{/if}}">
          <div class="lobby-character-stage"><canvas data-player-canvas data-room-id="{{room.id}}" data-mode="{{room.mode}}" data-player-username="{{student.username}}" data-teacher-present="{{room.teacher_present}}" data-spritesheet-image="{{student.spritesheetUrl}}" width="620" height="420" tabindex="0" aria-label="Use arrow keys or WASD to move your character"></canvas></div>
          <div class="lobby-phase-stack" data-lobby-phase data-room-id="{{room.id}}" data-role="student" data-mode="{{room.mode}}">
          <section class="student-live-quiz" data-phase-waiting{{#unless isWaiting}} hidden{{/unless}}>
            <p class="eyebrow">{{room.title}}</p>
            <h1>Waiting for the teacher to start...</h1>
            <div class="lobby-waiting-room" data-lobby-waiting-room>
              <p class="lobby-waiting-room-title">Everyone in the room</p>
              <div class="lobby-waiting-players" data-lobby-waiting-players><p class="lobby-players-empty">Waiting for players to join...</p></div>
              <div class="lobby-emotes" aria-label="Lobby emotes">
                <span>React</span>
                {{#if student.winnerAnimationsUnlocked}}<button type="button" data-lobby-emote="dance">Dance</button>
                <button type="button" data-lobby-emote="cheer">Cheer</button>{{/if}}
                <button type="button" data-lobby-emote="wave">Wave</button>
                <button type="button" data-lobby-emote="think">Think</button>
              </div>
            </div>
          </section>
          <section class="student-live-quiz" data-phase-countdown hidden>
            <p class="eyebrow">{{room.title}}</p><h1>Get ready: <span data-countdown>3</span></h1>
          </section>
          <section class="student-live-quiz" data-phase-running{{#unless isRunning}} hidden{{/unless}}>
            <p class="eyebrow">{{room.title}}</p>
            <h1>Question <span data-question-number>{{room.current_question}}</span> of {{totalQuestions}}</h1>
            <p class="question-timer"><span data-question-timer>30</span>s left</p>
            <div class="live-question">
              <h2 data-question-text>{{currentQuestion.question_text}}</h2>
              {{#if isQuicktype}}<form class="quicktype-answer-form" data-quicktype-form><input name="word" data-quicktype-input autocomplete="off" placeholder="Type the target word" required /><button class="practice-button" type="submit">Submit</button></form>{{else}}<div class="live-answer-grid">
                <button type="button" data-answer="a">{{currentQuestion.answer_a}}</button>
                <button type="button" data-answer="b">{{currentQuestion.answer_b}}</button>
                <button type="button" data-answer="c">{{currentQuestion.answer_c}}</button>
                <button type="button" data-answer="d">{{currentQuestion.answer_d}}</button>
              </div>{{/if}}
              <p data-answer-feedback></p>
            </div>
            <p>Your score: <strong data-live-score>{{participant.score}}</strong></p>
          </section>
          <section class="round-leaderboard-panel" data-phase-leaderboard{{#unless isLeaderboardPhase}} hidden{{/unless}}>
            <p class="eyebrow">Round results</p>
            <h2>Standings</h2>
            <ol class="round-leaderboard-list" data-round-leaderboard><li>Loading...</li></ol>
            <p class="admin-live-note">Waiting for the teacher to continue...</p>
          </section>
          <section class="final-results-panel" data-phase-finished{{#unless isFinished}} hidden{{/unless}}>
            <p class="eyebrow">Quiz complete</p>
            <h2>Final results</h2>
            <ol class="final-results-list" data-final-results><li>Loading...</li></ol>
          </section>
          </div>
        </div>
      </div>
      {{/if}}
    {{/if}}
  </section>
</main>
<div class="teacher-entrance-toast" data-teacher-entrance-toast role="status" aria-live="polite" hidden></div>
<div class="teacher-entrance-toast" data-lobby-closed-notice role="status" aria-live="assertive" hidden></div>
<audio data-teacher-entrance-audio preload="auto" src="/audio1/ElevenLabs_Evil_sinister_laugh_echoing_through_a_haunted_house_at_midnight.mp3"></audio>
<div id="lobby-exit-modal" class="lobby-exit-modal" hidden>
  <div class="lobby-exit-dialog" role="alertdialog" aria-modal="true" aria-labelledby="lobby-exit-title">
    <h2 id="lobby-exit-title">Are you sure you want to exit lobby?</h2>
    <div class="lobby-exit-actions">
      <button type="button" class="danger-button" data-lobby-exit-confirm>Yes</button>
      <button type="button" class="notes-button" data-lobby-exit-cancel>No</button>
    </div>
  </div>
</div>
<div class="winner-celebration-modal" data-winner-celebration hidden>
  <section class="winner-celebration-dialog" role="dialog" aria-modal="true" aria-labelledby="winner-celebration-title">
    <p class="eyebrow">Quiz champion</p>
    <div class="winner-medal-graphic" aria-hidden="true">🥇</div>
    <h2 id="winner-celebration-title">You took first place!</h2>
    <p class="winner-celebration-copy">A brilliant finish, <strong data-winner-celebration-name></strong>.</p>
    <div class="winner-celebration-character" aria-label="Your victory character">
      <canvas data-winner-celebration-canvas width="220" height="220"></canvas>
      <img data-winner-celebration-avatar alt="" hidden />
    </div>
    <p class="winner-celebration-score"><span data-winner-celebration-score></span> points</p>
    <button class="practice-button" type="button" data-winner-celebration-close>Continue</button>
  </section>
</div>
<script src="/socket.io/socket.io.js"></script>
<script>
  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
  function lobbyImageSrc(value) {
    const source = String(value || "");
    if (!source) return "";
    if (source.startsWith("data:image/") || source.startsWith("/") || source.startsWith("http")) return source;
    return `/uploads/profiles/${encodeURIComponent(source)}`;
  }
  window.lobbyImageSrc = lobbyImageSrc;
  const lobbyAnimationLayouts = {
    walk: { columns: 8, rows: 4 },
    slash: { columns: 6, rows: 4 },
    shoot: { columns: 13, rows: 4 },
    spell: { columns: 7, rows: 4 },
    thrust: { columns: 8, rows: 4 },
    idle: { columns: 1, rows: 4 },
    hurt: { columns: 6, rows: 1 },
    dance: { columns: 8, rows: 4 },
    cheer: { columns: 8, rows: 4 },
    wave: { columns: 6, rows: 4 },
    think: { columns: 6, rows: 4 },
  };
  const getLobbyAnimationLayout = (image, animation = "walk") => {
    const configured = lobbyAnimationLayouts[animation] || lobbyAnimationLayouts.walk;
    const frameSize = image.naturalWidth >= configured.columns * 192 &&
      image.naturalHeight >= configured.rows * 192 ? 192 :
      image.naturalWidth >= configured.columns * 128 &&
      image.naturalHeight >= configured.rows * 128 ? 128 : 64;
    return {
      animation,
      frameWidth: frameSize,
      frameHeight: frameSize,
      columns: Math.min(configured.columns, Math.max(1, Math.floor(image.naturalWidth / frameSize))),
      rows: Math.min(configured.rows, Math.max(1, Math.floor(image.naturalHeight / frameSize))),
    };
  };
  const logLobbySpriteLayout = (image, layout, frame, direction) => {
    const debugKey = `${layout.animation}:${layout.frameWidth}:${layout.columns}:${direction}:${frame}`;
    if (image.dataset.lobbyLayoutLogged === debugKey) return;
    image.dataset.lobbyLayoutLogged = debugKey;
    console.debug("Lobby sprite debug:", {
      selectedItem: image.dataset.lobbySelectedItem || "saved-character",
      animation: layout.animation,
      sheetDimensions: `${image.naturalWidth}x${image.naturalHeight}`,
      frameSize: `${layout.frameWidth}x${layout.frameHeight}`,
      frameCount: layout.columns,
      directionRow: direction,
      currentFrame: frame,
    });
  };
  const getLobbySpriteFrame = (username, direction, frame, now) => {
    const states = window.lobbyEmoteStates || new Map();
    const state = states.get(String(username));
    if (state) {
      const elapsed = now - state.startedAt;
      if (elapsed >= 2200) {
        states.delete(String(username));
      } else {
        const step = elapsed / 110;
        const emoteFrames = {
          cheer: { direction: 0, start: 0, count: 8 },
          wave: { direction: 1, start: 0, count: 6 },
          dance: { direction: 2, start: 0, count: 8 },
          think: { direction: 3, start: 0, count: 6 },
        };
        const animation = emoteFrames[state.emote];
        if (animation) {
          return {
            direction: animation.direction,
            frame: animation.start + Math.floor(step) % animation.count,
            animation: state.emote,
          };
        }
        return { direction: Number(direction) || 2, frame: Number(frame) || 0, animation: "walk" };
      }
    }
    return { direction: Number(direction) || 2, frame: Number(frame) || 0, animation: "walk" };
  };
  const enterSessionMode = () => {
    document.body.classList.add("in-session-mode");
    document.querySelector(".lobby-page")?.classList.add("lobby-active-session");
  };
  document.querySelectorAll('form[action="/lobby/start"], form[action="/lobby/quicktype/activate"]').forEach((form) => {
    form.addEventListener("submit", enterSessionMode);
  });
  const roomCreateForm = document.querySelector("[data-room-create]");
  if (roomCreateForm) {
    roomCreateForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const button = roomCreateForm.querySelector("button[type='submit']");
      if (button) button.disabled = true;
      const body = new URLSearchParams(new FormData(roomCreateForm));
      fetch(roomCreateForm.action, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body,
      }).then((response) => {
        if (!response.ok) throw new Error("Unable to create the game room.");
        window.location.assign(response.url);
      }).catch((error) => {
        if (button) button.disabled = false;
        const message = document.createElement("p");
        message.className = "account-error";
        message.textContent = error.message;
        roomCreateForm.appendChild(message);
      });
    });
  }

  const lobbyPhase = document.querySelector("[data-lobby-phase]");
  if (lobbyPhase) {
    const teacherStage = document.querySelector(".teacher-lobby-stage-wrap");
    const roomId = lobbyPhase.dataset.roomId;
    const role = lobbyPhase.dataset.role;
    const mode = lobbyPhase.dataset.mode;
    const socketUrl = "{{socketUrl}}" || window.location.origin;
    const lobbySocket = typeof io === "function" ? io(socketUrl, { withCredentials: true }) : null;
    window.lobbySocket = lobbySocket;
    const lobbyJoinedAt = Date.now();
    const lobbyStartupGracePeriod = 3000;
    let socketReady = Promise.resolve();
    if (lobbySocket) {
      socketReady = new Promise((resolve) => {
        let settled = false;
        let connected = lobbySocket.connected;
        let joined = false;
        const finish = (result) => {
          if (settled) return;
          settled = true;
          resolve(result);
        };
        const finishWhenReady = () => {
          if (connected && joined) finish({ ok: true });
        };
        lobbySocket.once("connect", () => {
          connected = true;
          finishWhenReady();
        });
        lobbySocket.once("connect_error", (error) => {
          console.warn("Unable to connect to lobby socket:", error.message);
          finish({ ok: false, error: error.message });
        });
        window.setTimeout(() => finish({ ok: false, error: "Socket handshake timed out." }), 3000);
        lobbySocket.emit("joinRoom", { roomId }, (result) => {
          if (!result?.ok) console.warn("Unable to join lobby socket:", result?.error);
          joined = Boolean(result?.ok);
          if (!joined) return finish(result);
          finishWhenReady();
        });
      });
      lobbySocket.on("playerMoved", (movement) => {
        window.lobbyPlayers = (window.lobbyPlayers || []).map((player) =>
          player.username === movement.username ? { ...player, ...movement } : player,
        );
      });
      lobbySocket.on("lobbyEmote", (emote) => {
        if (String(emote.roomId) !== String(roomId)) return;
        console.log("Received emote event:", emote);
        window.lobbyEmoteStates = window.lobbyEmoteStates || new Map();
        window.lobbyEmoteStates.set(String(emote.username), {
          emote: emote.emote,
          startedAt: performance.now(),
        });
      });
      lobbySocket.on("teacherEntered", ({ entering }) => {
        if (entranceButton) {
          entranceButton.textContent = entering ? "In Lobby" : "Enter Lobby";
          entranceButton.dataset.entering = entering ? "false" : "true";
          entranceButton.disabled = entering;
        }
      });
      lobbySocket.on("lobbyClosed", ({ message, closed, status } = {}) => {
        if (role !== "student" || lobbyClosedRedirecting) return;
        if (closed !== true && !["closed", "deleted"].includes(status)) return;
        const waitForInitialState = !initialLobbyStateReady ||
          Date.now() - lobbyJoinedAt < lobbyStartupGracePeriod;
        if (waitForInitialState) {
          window.setTimeout(() => {
            if (!initialLobbyStateReady) return;
            handleLobbyClosed({ message, closed, status });
          }, Math.max(0, lobbyStartupGracePeriod - (Date.now() - lobbyJoinedAt)));
          return;
        }
        handleLobbyClosed({ message, closed, status });
      });
    }
    const phaseWaiting = lobbyPhase.querySelector("[data-phase-waiting]");
    const phaseRunning = lobbyPhase.querySelector("[data-phase-running]");
    const phaseCountdown = lobbyPhase.querySelector("[data-phase-countdown]");
    const phaseLeaderboard = lobbyPhase.querySelector("[data-phase-leaderboard]");
    const phaseFinished = lobbyPhase.querySelector("[data-phase-finished]");
    const questionNumberEl = phaseRunning.querySelector("[data-question-number]");
    const questionTimerEl = phaseRunning.querySelector("[data-question-timer]");
    const answeredCountEl = phaseRunning.querySelector("[data-answered-count]");
    const totalParticipantsEl = phaseRunning.querySelector("[data-total-participants]");
    const questionTextEl = phaseRunning.querySelector("[data-question-text]");
    const feedback = phaseRunning.querySelector("[data-answer-feedback]");
    const score = phaseRunning.querySelector("[data-live-score]");
    const roundLeaderboardList = phaseLeaderboard.querySelector("[data-round-leaderboard]");
    const finalResultsList = phaseFinished.querySelector("[data-final-results]");
    const correctWordEl = phaseLeaderboard.querySelector("[data-correct-word]");
    const intermissionActions = document.querySelector("[data-intermission-actions]");
    const playersGrid = document.querySelector("[data-lobby-players]");
    const waitingPlayers = document.querySelector("[data-lobby-waiting-players]");
    const entranceButton = document.querySelector("[data-teacher-entrance]");
    const entranceToast = document.querySelector("[data-teacher-entrance-toast]");
    const lobbyClosedNotice = document.querySelector("[data-lobby-closed-notice]");
    const teacherEntranceSound = document.querySelector("[data-teacher-entrance-audio]");
    let lobbyClosedRedirecting = false;
    let initialLobbyStateReady = role === "admin";
    const handleLobbyClosed = ({ message, closed, status } = {}) => {
      if (role !== "student" || lobbyClosedRedirecting || !initialLobbyStateReady) return;
      if (closed !== true && !["closed", "deleted"].includes(status)) return;
      lobbyClosedRedirecting = true;
      if (lobbyClosedNotice) {
        lobbyClosedNotice.textContent = message || "The teacher has closed the lobby.";
        lobbyClosedNotice.hidden = false;
        lobbyClosedNotice.classList.remove("is-leaving");
      }
      window.setTimeout(() => window.location.assign("/"), 1200);
    };
    if (teacherEntranceSound) {
      teacherEntranceSound.preload = "auto";
      teacherEntranceSound.load();
    }
    let entranceAudioUnlocked = false;
    let pendingEntranceSound = false;
    let soundEnabled = localStorage.getItem("english-labs-lobby-sound") !== "off";
    const soundToggle = document.querySelector("[data-lobby-sound-toggle]");
    const soundLabel = document.querySelector("[data-lobby-sound-label]");
    const updateSoundControl = () => {
      if (soundLabel) soundLabel.textContent = soundEnabled ? "Sound on" : "Sound off";
      if (soundToggle) soundToggle.setAttribute("aria-pressed", String(soundEnabled));
      if (!soundEnabled && teacherEntranceSound) {
        teacherEntranceSound.pause();
        teacherEntranceSound.currentTime = 0;
      }
    };
    updateSoundControl();
    soundToggle?.addEventListener("click", () => {
      soundEnabled = !soundEnabled;
      localStorage.setItem("english-labs-lobby-sound", soundEnabled ? "on" : "off");
      updateSoundControl();
    });
    const unlockEntranceAudio = () => {
      if (!teacherEntranceSound || !soundEnabled) return;
      teacherEntranceSound.play().then(() => {
        entranceAudioUnlocked = true;
        teacherEntranceSound.pause();
        teacherEntranceSound.currentTime = 0;
        if (pendingEntranceSound) {
          pendingEntranceSound = false;
          if (soundEnabled) teacherEntranceSound.play().catch((error) => console.warn("Teacher entrance audio playback was blocked:", error));
        }
        window.removeEventListener("click", unlockEntranceAudio);
        window.removeEventListener("keydown", unlockEntranceAudio);
      }).catch(() => {});
    };
    if (role !== "admin") {
      window.addEventListener("click", unlockEntranceAudio);
      window.addEventListener("keydown", unlockEntranceAudio);
    }
    let currentQuestionNumber = Number(questionNumberEl.textContent) || 0;
    let previousRoomStatus = "waiting";
    let lastEvent = null;
    let lastEntranceEvent = null;

    const renderLeaderboardList = (target, players) => {
      const students = (players || [])
        .filter((player) => Number(player.isAdmin) !== 1 && player.role !== "teacher")
        .sort((first, second) => Number(second.score) - Number(first.score) || String(first.username).localeCompare(String(second.username)))
        .slice(0, 5);
      if (!students.length) {
        target.innerHTML = "<li>No scores yet.</li>";
        return;
      }

      const previousPositions = new Map(
        [...target.querySelectorAll("li[data-player-key]")]
          .map((row) => [row.dataset.playerKey, row.getBoundingClientRect()]),
      );
      const existingRows = new Map(
        [...target.querySelectorAll("li[data-player-key]")]
          .map((row) => [row.dataset.playerKey, row]),
      );
      const visibleKeys = new Set();

      students.forEach((player, index) => {
        const playerKey = String(player.username);
        const avatar = (player.avatarUrl || player.avatar)
          ? `<img src="${escapeHtml(lobbyImageSrc(player.avatarUrl || player.avatar))}" alt="" />`
          : `<span class="lobby-player-initial">${escapeHtml(player.username.charAt(0).toUpperCase())}</span>`;
        const row = existingRows.get(playerKey) || document.createElement("li");
        row.dataset.playerKey = playerKey;
        row.innerHTML = `<span class="round-leaderboard-rank">${index + 1}</span><span class="round-leaderboard-avatar">${avatar}</span><span class="round-leaderboard-name">${escapeHtml(player.username)}</span><strong>${player.score}</strong>`;
        visibleKeys.add(playerKey);
        target.append(row);
      });

      existingRows.forEach((row, playerKey) => {
        if (!visibleKeys.has(playerKey)) row.remove();
      });

      requestAnimationFrame(() => {
        students.forEach((player) => {
          const row = target.querySelector(`[data-player-key="${CSS.escape(String(player.username))}"]`);
          const previous = previousPositions.get(String(player.username));
          if (!row || !previous) return;
          const current = row.getBoundingClientRect();
          const deltaX = previous.left - current.left;
          const deltaY = previous.top - current.top;
          if (!deltaX && !deltaY) return;
          row.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
          row.style.transition = "none";
          requestAnimationFrame(() => {
            row.style.transition = "transform 380ms cubic-bezier(0.22, 1, 0.36, 1)";
            row.style.transform = "";
          });
        });
      });
    };
    const renderFinalResults = (players) => {
      const students = (players || []).filter((player) => Number(player.isAdmin) !== 1 && player.role !== "teacher");
      if (!students.length) { finalResultsList.innerHTML = "<li>No scores yet.</li>"; return; }
      finalResultsList.innerHTML = students.map((player, index) => {
        const avatar = (player.avatarUrl || player.avatar)
        ? `<img class="profile-avatar-img" src="${escapeHtml(lobbyImageSrc(player.avatarUrl || player.avatar))}" alt="" />`
          : `<span class="lobby-player-initial">${escapeHtml(player.username.charAt(0).toUpperCase())}</span>`;
        return `<li class="final-results-row${index === 0 ? " final-results-winner" : ""}"><div class="final-results-avatar">${avatar}</div><span class="final-results-name">${index + 1}. ${escapeHtml(player.username)}</span><strong class="final-results-score">${player.score}</strong></li>`;
      }).join("");
    };
    const winnerCelebrationModal = document.querySelector("[data-winner-celebration]");
    const winnerCelebrationCanvas = winnerCelebrationModal?.querySelector("[data-winner-celebration-canvas]");
    const winnerCelebrationAvatar = winnerCelebrationModal?.querySelector("[data-winner-celebration-avatar]");
    const winnerCelebrationName = winnerCelebrationModal?.querySelector("[data-winner-celebration-name]");
    const winnerCelebrationScore = winnerCelebrationModal?.querySelector("[data-winner-celebration-score]");
    let winnerCelebrationShown = false;
    let winnerAnimationToken = 0;
    const closeWinnerCelebration = () => {
      if (!winnerCelebrationModal) return;
      winnerAnimationToken += 1;
      winnerCelebrationModal.hidden = true;
      document.body.classList.remove("winner-celebration-open");
    };
    winnerCelebrationModal?.querySelector("[data-winner-celebration-close]")?.addEventListener("click", closeWinnerCelebration);
    const showWinnerCelebration = (players) => {
      if (role !== "student" || winnerCelebrationShown || !winnerCelebrationModal) return;
      const currentUsername = String(document.querySelector("[data-player-canvas]")?.dataset.playerUsername || "{{student.username}}");
      const winner = (players || []).find((player) => Number(player.isAdmin) !== 1 && player.role !== "teacher");
      if (!winner || String(winner.username) !== currentUsername) return;
      winnerCelebrationShown = true;
      winnerCelebrationName.textContent = winner.username;
      winnerCelebrationScore.textContent = winner.score;
      winnerCelebrationModal.hidden = false;
      document.body.classList.add("winner-celebration-open");
      const source = winner.spritesheetUrl || winner.spritesheet || winner.avatarUrl || winner.avatar;
      if (!source || !winnerCelebrationCanvas) return;
      winnerAnimationToken += 1;
      const animationToken = winnerAnimationToken;
      const context = winnerCelebrationCanvas.getContext("2d");
      const image = new Image();
      winnerCelebrationAvatar.src = lobbyImageSrc(source);
      winnerCelebrationAvatar.hidden = false;
      image.onload = () => {
        if (animationToken !== winnerAnimationToken) return;
        const isSpriteSheet = image.naturalWidth >= 256 && image.naturalHeight >= 128;
        winnerCelebrationAvatar.hidden = isSpriteSheet;
        winnerCelebrationCanvas.hidden = !isSpriteSheet;
        if (!isSpriteSheet) return;
        const layout = getLobbyAnimationLayout(image, "cheer");
        const drawVictoryFrame = (now) => {
          if (animationToken !== winnerAnimationToken || winnerCelebrationModal.hidden) return;
          const frame = Math.floor(now / 110) % layout.columns;
          context.clearRect(0, 0, winnerCelebrationCanvas.width, winnerCelebrationCanvas.height);
          context.imageSmoothingEnabled = false;
          context.drawImage(
            image,
            frame * layout.frameWidth,
            0,
            layout.frameWidth,
            layout.frameHeight,
            20,
            4,
            180,
            180,
          );
          window.requestAnimationFrame(drawVictoryFrame);
        };
        window.requestAnimationFrame(drawVictoryFrame);
      };
      image.onerror = () => {
        winnerCelebrationCanvas.hidden = true;
        winnerCelebrationAvatar.hidden = false;
      };
      image.src = lobbyImageSrc(source);
    };

    const refresh = () => socketReady.then(() => fetch(`/api/lobby/state?roomId=${roomId}`)).then((response) => response.json()).then((state) => {
      if (!state.room || state.room.id !== Number(roomId)) return;
      if (!initialLobbyStateReady) initialLobbyStateReady = true;
      if (teacherStage && role === "admin") {
        teacherStage.classList.toggle("is-live-question", state.room.status === "running");
        teacherStage.classList.toggle("is-intermission", state.room.status === "leaderboard");
      }
      const enteredRunningState =
        previousRoomStatus !== "running" && state.room.status === "running";
      previousRoomStatus = state.room.status;
      const teacherPresent = Number(state.room.teacher_present) === 1;
      document.querySelectorAll("[data-player-canvas]").forEach((canvas) => {
        canvas.dataset.teacherPresent = teacherPresent ? "1" : "0";
      });
      window.lobbySetTeacherPresent?.(teacherPresent);
      window.lobbyTeacherPresent = teacherPresent ? 1 : 0;
      if (entranceButton) {
        entranceButton.textContent = teacherPresent ? "In Lobby" : "Enter Lobby";
        entranceButton.dataset.entering = teacherPresent ? "false" : "true";
        entranceButton.disabled = teacherPresent;
      }
      if (state.event?.startsWith("TEACHER_ENTRANCE:") && state.event !== lastEntranceEvent) {
        lastEntranceEvent = state.event;
        if (entranceToast) {
          entranceToast.textContent = "Uh oh... Teacher has entered the arena! Quick, act natural!";
          entranceToast.hidden = false;
          entranceToast.classList.remove("is-leaving");
          window.setTimeout(() => {
            entranceToast.classList.add("is-leaving");
            window.setTimeout(() => { entranceToast.hidden = true; }, 350);
          }, 3650);
        }
        if (role !== "admin") {
          teacherEntranceSound.currentTime = 0;
          if (entranceAudioUnlocked) {
            if (soundEnabled) teacherEntranceSound.play().catch((error) => console.warn("Teacher entrance audio playback was blocked:", error));
          } else {
            pendingEntranceSound = true;
          }
        }
      }
      if (state.event === "NEXT_WORD_PREPARED" && state.event !== lastEvent) {
        lastEvent = state.event;
        const input = lobbyPhase.querySelector("[data-quicktype-input]");
        if (input) { input.value = ""; input.disabled = true; }
        const submit = lobbyPhase.querySelector("[data-quicktype-form] button");
        if (submit) submit.disabled = true;
        if (feedback) feedback.textContent = "";
      }
      if (state.event !== "NEXT_WORD_PREPARED") lastEvent = state.event;
      window.lobbyPlayers = state.leaderboard || [];
      if (score) score.textContent = state.participant?.score || 0;

      if (playersGrid) {
        playersGrid.innerHTML = state.leaderboard?.length
          ? state.leaderboard.map((player) => {
              const avatar = (player.avatarUrl || player.avatar)
                ? `<img class="profile-avatar-img" src="${escapeHtml(lobbyImageSrc(player.avatarUrl || player.avatar))}" alt="" />`
                : `<span class="lobby-player-initial">${escapeHtml(player.username.charAt(0).toUpperCase())}</span>`;
              return `<div class="lobby-player-tile"><div class="lobby-player-avatar">${avatar}</div><span class="lobby-player-name">${escapeHtml(player.username)}</span><strong class="lobby-player-score">${player.score}</strong></div>`;
            }).join("")
          : "<p class=\"lobby-players-empty\">Waiting for players to join...</p>";
      }
      if (waitingPlayers) {
        waitingPlayers.innerHTML = state.leaderboard?.length
          ? state.leaderboard.map((player) => {
              const avatar = (player.avatarUrl || player.avatar)
                ? `<img class="profile-avatar-img" src="${escapeHtml(lobbyImageSrc(player.avatarUrl || player.avatar))}" alt="" />`
                : `<span class="lobby-player-initial">${escapeHtml(player.username.charAt(0).toUpperCase())}</span>`;
              return `<article class="lobby-waiting-player"><div class="lobby-waiting-avatar">${avatar}</div><strong>${escapeHtml(player.username)}</strong></article>`;
            }).join("")
          : "<p class=\"lobby-players-empty\">Waiting for players to join...</p>";
      }

      document.querySelector("[data-teacher-entrance]")?.addEventListener("click", (event) => {
        const button = event.currentTarget;
        button.disabled = true;
        const entering = button.dataset.entering === "true";
        const update = lobbySocket
          ? new Promise((resolve, reject) => lobbySocket.emit("teacherEntrance", { roomId, entering }, (result) => result?.ok ? resolve(result) : reject(new Error(result?.error || "Unable to update lobby entrance."))))
          : fetch("/api/lobby/teacher-entrance", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ roomId, entering }) }).then((response) => response.json().then((result) => ({ ...result, ok: response.ok })));
        update
          .then((result) => {
            if (result.ok === false) throw new Error(result.error || "Unable to update lobby entrance.");
            window.lobbySetTeacherPresent?.(result.teacherPresent ?? entering);
            button.textContent = "In Lobby";
            button.disabled = true;
          })
          .catch((error) => console.error(error))
          .finally(() => { button.disabled = false; });
      });

      document.querySelectorAll("[data-lobby-emote]").forEach((button) => {
        if (button.dataset.emoteBound) return;
        button.dataset.emoteBound = "true";
        button.addEventListener("click", () => {
          const emoteType = button.dataset.lobbyEmote;
          console.log("Emote clicked:", emoteType);
          window.lobbyEmoteStates = window.lobbyEmoteStates || new Map();
          window.lobbyEmoteStates.set(
            String(document.querySelector("[data-player-canvas]")?.dataset.playerUsername || "{{student.username}}"),
            {
              emote: button.dataset.lobbyEmote,
              startedAt: performance.now(),
            },
          );
          if (lobbySocket?.connected) {
            console.log("Sending emote event:", {
              roomId,
              emote: emoteType,
            });
            lobbySocket.emit("lobbyEmote", {
              roomId,
              emote: emoteType,
            });
          } else {
            console.warn("Unable to send emote: lobby socket is not connected.");
          }
          if (emoteStatus) emoteStatus.textContent = `You chose ${button.textContent}.`;
        });
      });

      if (phaseWaiting) phaseWaiting.hidden = state.room.status !== "waiting";
      phaseRunning.hidden = state.room.status !== "running";
      if (phaseCountdown) phaseCountdown.hidden = state.room.status !== "countdown";
      phaseLeaderboard.hidden = state.room.status !== "leaderboard";
      if (intermissionActions) {
        if (state.room.status === "leaderboard" && !intermissionActions.firstElementChild && mode !== "quicktype") {
          const form = document.createElement("form");
          form.className = "lobby-inline-form intermission-next-form";
          form.action = "/lobby/next";
          form.method = "post";
          const roomInput = document.createElement("input");
          roomInput.type = "hidden";
          roomInput.name = "roomId";
          roomInput.value = roomId;
          const button = document.createElement("button");
          button.className = "practice-button";
          button.type = "submit";
          button.textContent = "Next Question";
          form.append(roomInput, button);
          intermissionActions.append(form);
        } else if (state.room.status !== "leaderboard") {
          intermissionActions.replaceChildren();
        }
      }
      const gameFinished =
        state.room.status === "finished" &&
        Number(state.totalQuestions) > 0 &&
        Number(state.room.current_question) > Number(state.totalQuestions);
      phaseFinished.hidden = !gameFinished;
      if (activateButton) activateButton.disabled = role !== "admin" || state.room.status !== "waiting" || !state.question;
      const nextWordButton = lobbyPhase.querySelector("[data-next-word]");
      if (nextWordButton && state.room.status === "leaderboard") {
        nextWordButton.textContent = state.room.current_question >= state.totalQuestions ? "Finish Game" : "Next Word";
      }

      if (state.room.status === "countdown") {
        lobbyPhase.querySelectorAll("[data-countdown]").forEach((element) => { element.textContent = state.countdownRemaining; });
      }
      if (state.room.status === "waiting" && state.question) {
        lobbyPhase.querySelectorAll("[data-question-number]").forEach((element) => { element.textContent = state.room.current_question; });
        const targetWordEl = lobbyPhase.querySelector("[data-target-word]");
        if (targetWordEl && state.question.target_word) targetWordEl.textContent = state.question.target_word;
      }
      if (state.room.status === "running" && state.question) {
        questionNumberEl.textContent = state.room.current_question;
        questionTimerEl.textContent = state.timeRemaining;
        const quicktypeInput = phaseRunning.querySelector("[data-quicktype-input]");
        const quicktypeSubmit = phaseRunning.querySelector("[data-quicktype-form] button");
        if (answeredCountEl) answeredCountEl.textContent = state.answeredCount;
        if (totalParticipantsEl) totalParticipantsEl.textContent = state.totalParticipants;
        const isNewQuestion =
          currentQuestionNumber !== state.room.current_question || enteredRunningState;
        if (isNewQuestion) {
          currentQuestionNumber = state.room.current_question;
          if (questionTextEl) questionTextEl.textContent = state.question.question_text;
          const targetWordEl = phaseRunning.querySelector("[data-target-word]");
          if (targetWordEl && state.question.target_word) targetWordEl.textContent = state.question.target_word;
          if (quicktypeInput) { quicktypeInput.value = ""; quicktypeInput.disabled = false; }
          if (quicktypeSubmit) quicktypeSubmit.disabled = false;
          [["a", "answer_a"], ["b", "answer_b"], ["c", "answer_c"], ["d", "answer_d"]].forEach(([key, field]) => {
            const answerEl = phaseRunning.querySelector(`[data-answer="${key}"], [data-answer-text="${key}"]`);
            if (answerEl) { answerEl.textContent = state.question[field]; answerEl.disabled = false; }
          });
          if (feedback) feedback.textContent = "";
        }
        if (mode === "quicktype" && role === "student" && state.participant?.answer == null) {
          if (quicktypeInput) quicktypeInput.disabled = false;
          if (quicktypeSubmit) quicktypeSubmit.disabled = false;
        }
      }
      if (state.room.status === "waiting") {
        const input = lobbyPhase.querySelector("[data-quicktype-input]");
        if (input) input.disabled = true;
        const submit = lobbyPhase.querySelector("[data-quicktype-form] button");
        if (submit) submit.disabled = true;
      }
      if (state.room.status === "leaderboard") {
        renderLeaderboardList(roundLeaderboardList, state.leaderboard);
        if (correctWordEl) correctWordEl.textContent = state.correctWord || "";
      }
      if (gameFinished) {
        renderFinalResults(state.leaderboard);
        showWinnerCelebration(state.leaderboard);
      }
    });

    lobbySocket?.on("lobbyStateChanged", () => refresh());
    window.setInterval(refresh, 1000);

    const activateButton = lobbyPhase.querySelector("[data-activate-word]");
    if (role === "admin" && activateButton) activateButton.addEventListener("click", () => {
      enterSessionMode();
      activateButton.disabled = true;
      fetch("/lobby/quicktype/activate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ roomId }),
      }).then(() => refresh());
    });

    if (role === "student") {
      const quicktypeForm = phaseRunning.querySelector("[data-quicktype-form]");
      if (mode === "quicktype" && quicktypeForm) quicktypeForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const input = quicktypeForm.querySelector("[data-quicktype-input]");
        if (!input.value.trim()) return;
        input.disabled = true;
        quicktypeForm.querySelector("button").disabled = true;
        fetch("/lobby/quicktype/submit", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ roomId, word: input.value }) })
          .then((response) => response.json())
          .then((result) => { if (feedback) feedback.textContent = result.correct ? `Correct! +${result.points}` : (result.answered ? "Not quite." : result.error || "Unable to submit."); refresh(); });
      });
      phaseRunning.querySelectorAll("[data-answer]").forEach((button) => button.addEventListener("click", () => {
        phaseRunning.querySelectorAll("[data-answer]").forEach((item) => item.disabled = true);
        fetch("/lobby/answer", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ roomId, answer: button.dataset.answer }) })
          .then((response) => response.json())
          .then((result) => { if (feedback) feedback.textContent = result.correct ? "Correct!" : "Not quite."; refresh(); });
      }));
    }

    refresh();
  }

  const setupForm = document.querySelector("[data-quicktype-setup]");
  if (setupForm) {
    const userId = document.querySelector(".lobby-page")?.dataset.userId || "anonymous";
    const quicktypeUsedWordIdsKey = `quicktypeUsedWordIds_${userId}`;
    const picker = setupForm.querySelector(".quicktype-word-picker");
    const orderList = setupForm.querySelector("[data-word-order]");
    const count = setupForm.querySelector("[data-selected-count]");
    const createButton = setupForm.querySelector("[data-create-game]");
    const search = setupForm.querySelector("[data-word-search]");
    let savedUsedWordIds = [];
    try {
      savedUsedWordIds = JSON.parse(localStorage.getItem(quicktypeUsedWordIdsKey) || "[]");
    } catch (error) {
      savedUsedWordIds = [];
    }
    const usedWordIds = new Set(Array.isArray(savedUsedWordIds) ? savedUsedWordIds.map(String) : []);
    picker.querySelectorAll("[data-word-option]").forEach((card) => {
      if (usedWordIds.has(card.dataset.wordId)) card.classList.add("previously-used");
    });
    const renderOrder = () => {
      const selected = [...setupForm.querySelectorAll(".word-card.selected")];
      orderList.innerHTML = selected.map((checkbox) => {
        return `<li draggable="true" data-order-id="${checkbox.dataset.wordId}">${escapeHtml(checkbox.querySelector("span").textContent)}</li>`;
      }).join("");
      count.textContent = selected.length;
      createButton.disabled = selected.length === 0;
      orderList.querySelectorAll("li").forEach((item) => item.addEventListener("dragstart", (event) => event.dataTransfer.setData("text/plain", item.dataset.orderId)));
    };
    picker.addEventListener("click", (event) => {
      const card = event.target.closest("[data-word-option]");
      if (!card) return;
      card.classList.toggle("selected");
      card.setAttribute("aria-pressed", card.classList.contains("selected"));
      renderOrder();
    });
    orderList.addEventListener("dragover", (event) => event.preventDefault());
    orderList.addEventListener("drop", (event) => {
      event.preventDefault();
      const dragged = orderList.querySelector(`[data-order-id="${event.dataTransfer.getData("text/plain")}"]`);
      const target = event.target.closest("li");
      if (dragged && target && dragged !== target) orderList.insertBefore(dragged, target);
    });
    search.addEventListener("input", () => {
      const term = search.value.toLocaleLowerCase();
      picker.querySelectorAll("[data-word-option]").forEach((option) => { option.hidden = !option.textContent.toLocaleLowerCase().includes(term); });
    });
    setupForm.addEventListener("submit", (event) => {
      event.preventDefault();
      setupForm.querySelectorAll("input[name='wordIds']").forEach((input) => input.remove());
      orderList.querySelectorAll("[data-order-id]").forEach((item) => {
        const input = document.createElement("input");
        input.type = "hidden"; input.name = "wordIds"; input.value = item.dataset.orderId;
        setupForm.appendChild(input);
        usedWordIds.add(item.dataset.orderId);
      });
      localStorage.setItem(quicktypeUsedWordIdsKey, JSON.stringify([...usedWordIds]));
      setupForm.submit();
    });
  }

  const playerCanvas = document.querySelector("[data-player-canvas]");
  if (playerCanvas) {
    const playerContext = playerCanvas.getContext("2d");
    playerContext.imageSmoothingEnabled = false;
    const frameCanvas = document.createElement("canvas");
    frameCanvas.width = playerCanvas.width;
    frameCanvas.height = playerCanvas.height;
    const frameContext = frameCanvas.getContext("2d");
    const RENDER_SIZE = 78;
    playerContext.imageSmoothingEnabled = false;
    frameContext.imageSmoothingEnabled = false;
    const player = { x: 310, y: 380, speed: 4, direction: 2, frame: 0, isMoving: false, image: new Image(), isLoaded: false, isPresent: playerCanvas.dataset.playerAdmin !== "true" || playerCanvas.dataset.playerPresent === "1" };
    const pressedKeys = new Set();
    const remoteImages = new Map();
    const remotePositions = new Map();
    const LERP_FACTOR = 0.18;
    let pointerPosition = null;
    let lastSyncAt = 0;
    let lastSyncedState = "";
    const directionByKey = { ArrowUp: 0, w: 0, ArrowLeft: 1, a: 1, ArrowDown: 2, s: 2, ArrowRight: 3, d: 3 };
    const getEmoteSpriteState = (username, direction, frame, now) =>
      getLobbySpriteFrame(username, direction, frame, now);
    const drawPlayer = () => {
      const now = timestampNow();
      player.isMoving = pressedKeys.size > 0;
      if (player.isMoving) {
        const activeKey = [...pressedKeys][pressedKeys.size - 1];
        player.direction = directionByKey[activeKey];
        player.frame = (player.frame + 0.2) % 8;
        const movement = [...pressedKeys].reduce((result, key) => {
          if (key === "ArrowUp" || key === "w") result.y -= 1;
          if (key === "ArrowDown" || key === "s") result.y += 1;
          if (key === "ArrowLeft" || key === "a") result.x -= 1;
          if (key === "ArrowRight" || key === "d") result.x += 1;
          return result;
        }, { x: 0, y: 0 });
        const length = Math.hypot(movement.x, movement.y) || 1;
        player.x = Math.max(RENDER_SIZE / 2, Math.min(playerCanvas.width - RENDER_SIZE / 2, player.x + movement.x / length * player.speed));
        player.y = Math.max(RENDER_SIZE, Math.min(playerCanvas.height, player.y + movement.y / length * player.speed));
      } else {
        player.frame = 0;
      }

      frameContext.clearRect(0, 0, frameCanvas.width, frameCanvas.height);
      const drawSprite = (image, x, y, direction, frame, username, isAdmin, animation = "walk") => {
        if (!image.complete || image.naturalWidth < 64 || image.naturalHeight < 64) return;
        const layout = getLobbyAnimationLayout(image, animation);
        const safeDirection = Math.max(0, Math.min(layout.rows - 1, Math.floor(direction)));
        const safeFrame = Math.max(0, Math.min(layout.columns - 1, Math.floor(frame)));
        const sx = safeFrame * layout.frameWidth;
        const sy = safeDirection * layout.frameHeight;
        logLobbySpriteLayout(image, layout, safeFrame, safeDirection);
        const drawX = Math.floor(x - (RENDER_SIZE / 2));
        const drawY = Math.floor(y - RENDER_SIZE);
        frameContext.drawImage(
          image,
          sx,
          sy,
          layout.frameWidth,
          layout.frameHeight,
          drawX,
          drawY,
          RENDER_SIZE,
          RENDER_SIZE,
        );
        if (isAdmin) {
          frameContext.font = "700 9px sans-serif";
          frameContext.textAlign = "center";
          frameContext.textBaseline = "bottom";
          const badge = "Teacher";
          const badgeWidth = frameContext.measureText(badge).width + 8;
          const badgeY = drawY - 4;
          frameContext.fillStyle = "#2D4B7B";
          frameContext.fillRect(Math.floor(x - badgeWidth / 2), badgeY - 13, badgeWidth, 14);
          frameContext.fillStyle = "#ffffff";
          frameContext.fillText(badge, Math.floor(x), badgeY - 2);
        }
        const isHovered = pointerPosition && pointerPosition.x >= x - RENDER_SIZE / 2 && pointerPosition.x <= x + RENDER_SIZE / 2 && pointerPosition.y >= y - RENDER_SIZE && pointerPosition.y <= y;
        if (username && isHovered) {
          frameContext.font = "700 8px Teachers, sans-serif";
          frameContext.textAlign = "center";
          frameContext.textBaseline = "bottom";
          const label = String(username).slice(0, 18);
          const labelX = Math.floor(x);
          const labelY = drawY - 3;
          const labelWidth = frameContext.measureText(label).width + 6;
          frameContext.fillStyle = "rgba(41, 29, 24, 0.88)";
          frameContext.fillRect(labelX - labelWidth / 2, labelY - 11, labelWidth, 13);
          frameContext.fillStyle = "#ffffff";
          frameContext.shadowColor = "rgba(0, 0, 0, 0.8)";
          frameContext.shadowBlur = 2;
          frameContext.fillText(label, labelX, labelY);
          frameContext.shadowBlur = 0;
        }
      };
      const resizeCanvas = () => {
        const stage = playerCanvas.closest(".lobby-character-stage");
        if (!stage) return;
        const width = Math.max(310, Math.floor(playerCanvas.clientWidth || stage.clientWidth));
        const height = Math.max(210, Math.floor(playerCanvas.clientHeight || stage.clientHeight));
        if (playerCanvas.width === width && playerCanvas.height === height) return;
        const previousWidth = playerCanvas.width;
        playerCanvas.width = width;
        playerCanvas.height = height;
        frameCanvas.width = width;
        frameCanvas.height = height;
        if (previousWidth > 0 && previousWidth !== width) {
          player.x = Math.max(RENDER_SIZE / 2, Math.min(width - RENDER_SIZE / 2, player.x * width / previousWidth));
        }
      };
      resizeCanvas();
      if (window.ResizeObserver) new ResizeObserver(resizeCanvas).observe(playerCanvas.closest(".lobby-character-stage"));
      const ownUsername = String(playerCanvas.dataset.playerUsername || "");
      const hasRemoteSelf = (window.lobbyPlayers || []).some(
        (remotePlayer) => String(remotePlayer.username) === ownUsername,
      );
      if (player.isLoaded && player.isPresent && !hasRemoteSelf) {
        const animatedPlayer = getEmoteSpriteState(
          ownUsername,
          player.direction,
          player.frame,
          now,
        );
        drawSprite(player.image, player.x, player.y, animatedPlayer.direction, animatedPlayer.frame, ownUsername, playerCanvas.dataset.playerAdmin === "true", animatedPlayer.animation);
      }
      (window.lobbyPlayers || []).forEach((remotePlayer) => {
        const remoteSpritesheet = remotePlayer.spritesheetUrl || remotePlayer.spritesheet;
        if (!remoteSpritesheet || (Number(remotePlayer.isAdmin) === 1 && Number(playerCanvas.dataset.teacherPresent) !== 1)) return;
        const remoteKey = String(remotePlayer.userId || remotePlayer.username);
        const targetX = Number(remotePlayer.x) || 310;
        const targetY = Number(remotePlayer.y) || 380;
        const previousPosition = remotePositions.get(remoteKey);
        const remotePosition = previousPosition || { x: targetX, y: targetY };
        remotePosition.targetX = targetX;
        remotePosition.targetY = targetY;
        remotePosition.x += (remotePosition.targetX - remotePosition.x) * LERP_FACTOR;
        remotePosition.y += (remotePosition.targetY - remotePosition.y) * LERP_FACTOR;
        if (Math.hypot(remotePosition.targetX - remotePosition.x, remotePosition.targetY - remotePosition.y) < 0.5) {
          remotePosition.x = remotePosition.targetX;
          remotePosition.y = remotePosition.targetY;
        }
        remotePositions.set(remoteKey, remotePosition);
        const cachedRemote = remoteImages.get(remoteKey);
        let remoteImage = cachedRemote?.key === remoteSpritesheet ? cachedRemote.image : null;
        if (!remoteImage) {
          remoteImage = new Image();
          const remoteSource = window.lobbyImageSrc(remoteSpritesheet);
          remoteImage.src = `${remoteSource}${remoteSource.startsWith("data:") ? "" : `?t=${encodeURIComponent(remoteSource)}`}`;
          remoteImages.set(remoteKey, { key: remoteSpritesheet, image: remoteImage });
        }
        const animatedRemote = getEmoteSpriteState(
          remotePlayer.username,
          Number(remotePlayer.direction) || 2,
          Number(remotePlayer.frame) || 0,
          now,
        );
        drawSprite(remoteImage, remotePosition.x, remotePosition.y, animatedRemote.direction, animatedRemote.frame, remotePlayer.username, Number(remotePlayer.isAdmin) === 1, animatedRemote.animation);
      });
      playerContext.clearRect(0, 0, playerCanvas.width, playerCanvas.height);
      playerContext.drawImage(frameCanvas, 0, 0);
      const syncState = `${player.x},${player.y},${player.direction},${player.frame.toFixed(2)}`;
      if (player.isMoving && syncState !== lastSyncedState && timestampNow() - lastSyncAt > 50) {
        lastSyncAt = timestampNow();
        lastSyncedState = syncState;
        const movement = { roomId: playerCanvas.dataset.roomId, x: player.x, y: player.y, direction: player.direction, frame: player.frame };
        if (window.lobbySocket?.connected) window.lobbySocket.emit("playerMove", movement);
      }
      window.requestAnimationFrame(drawPlayer);
    };

    const timestampNow = () => performance.now();

    window.addEventListener("keydown", (event) => {
      const activeElement = document.activeElement;
      if (
        activeElement?.tagName === "INPUT" ||
        activeElement?.tagName === "TEXTAREA" ||
        activeElement?.isContentEditable
      ) {
        pressedKeys.clear();
        return;
      }
      if (!(event.key in directionByKey)) return;
      event.preventDefault();
      pressedKeys.add(event.key);
    });
    window.addEventListener("keyup", (event) => pressedKeys.delete(event.key));
    window.addEventListener("blur", () => pressedKeys.clear());
    playerCanvas.addEventListener("mousemove", (event) => {
      const bounds = playerCanvas.getBoundingClientRect();
      pointerPosition = {
        x: (event.clientX - bounds.left) * playerCanvas.width / bounds.width,
        y: (event.clientY - bounds.top) * playerCanvas.height / bounds.height,
      };
    });
    playerCanvas.addEventListener("mouseleave", () => { pointerPosition = null; });
    const loadPlayerImage = (source) => {
      const updatedImage = new Image();
      updatedImage.onload = () => { player.image = updatedImage; player.isLoaded = true; };
      updatedImage.src = `${source}${source.startsWith("data:") ? "" : `?t=${Date.now()}`}`;
    };
    window.lobbyLoadPlayerImage = loadPlayerImage;
    window.lobbySetTeacherPresent = (present) => { player.isPresent = present; window.lobbyTeacherPresent = present ? 1 : 0; };
    const scopedSpritesheetKey = `userSpritesheet_${playerCanvas.dataset.playerUserId || playerCanvas.dataset.playerUsername}`;
    loadPlayerImage(localStorage.getItem(scopedSpritesheetKey) || playerCanvas.dataset.spritesheetImage);
    window.requestAnimationFrame(drawPlayer);
  }

  const lobbySettings = document.querySelector("[data-lobby-settings]");
  const lobbySettingsToggle = document.querySelector("[data-lobby-settings-toggle]");
  const lobbySettingsMenu = document.querySelector("[data-lobby-settings-menu]");
  if (lobbySettings && lobbySettingsToggle && lobbySettingsMenu) {
    const closeLobbySettings = () => {
      lobbySettingsMenu.hidden = true;
      lobbySettingsToggle.setAttribute("aria-expanded", "false");
    };
    lobbySettingsToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = !lobbySettingsMenu.hidden;
      lobbySettingsMenu.hidden = isOpen;
      lobbySettingsToggle.setAttribute("aria-expanded", String(!isOpen));
    });
    document.addEventListener("click", (event) => {
      if (!lobbySettings.contains(event.target)) closeLobbySettings();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeLobbySettings();
    });
    if (!lobbyPhase) {
      const soundToggle = lobbySettings.querySelector("[data-lobby-sound-toggle]");
      const soundLabel = lobbySettings.querySelector("[data-lobby-sound-label]");
      const updateJoinSoundControl = () => {
        const soundEnabled = localStorage.getItem("english-labs-lobby-sound") !== "off";
        if (soundLabel) soundLabel.textContent = soundEnabled ? "Sound on" : "Sound off";
        if (soundToggle) soundToggle.setAttribute("aria-pressed", String(soundEnabled));
      };
      updateJoinSoundControl();
      soundToggle?.addEventListener("click", () => {
        const soundEnabled = localStorage.getItem("english-labs-lobby-sound") !== "off";
        localStorage.setItem("english-labs-lobby-sound", soundEnabled ? "off" : "on");
        updateJoinSoundControl();
      });
    }
  }

  const chooseQuizButton = document.querySelector("[data-choose-quiz]");
  const quizSelector = document.querySelector("[data-quiz-selector]");
  const quizSelectorGrid = document.querySelector("[data-quiz-selector-grid]");
  const quizSelectorClose = document.querySelector("[data-quiz-selector-close]");
  const roomIdForQuizSelection = document.querySelector("[data-lobby-phase]")?.dataset.roomId;
  const closeQuizSelector = () => {
    if (quizSelector) quizSelector.hidden = true;
  };
  const renderQuizCards = (quizzes) => {
    if (!quizSelectorGrid) return;
    quizSelectorGrid.innerHTML = quizzes.length
      ? quizzes.map((quiz) => `<button class="quiz-selector-card" type="button" data-quiz-id="${escapeHtml(quiz.quiz_id)}"><strong>${escapeHtml(quiz.topic_title)}</strong><span>${escapeHtml(quiz.chapter_title)}${quiz.cefr_level ? ` · ${escapeHtml(quiz.cefr_level)}` : ""}</span><small>${quiz.question_count} questions</small></button>`).join("")
      : "<p class=\"admin-live-note\">No pre-made quizzes are available.</p>";
    quizSelectorGrid.querySelectorAll("[data-quiz-id]").forEach((card) => {
      card.addEventListener("click", async () => {
        card.disabled = true;
        card.classList.add("is-loading");
        try {
          const response = await fetch("/api/lobby/select-quiz", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ roomId: roomIdForQuizSelection, quizId: card.dataset.quizId }),
          });
          if (!response.ok) throw new Error("Unable to select quiz");
          window.location.reload();
        } catch (error) {
          card.disabled = false;
          card.classList.remove("is-loading");
          if (quizSelectorGrid) quizSelectorGrid.insertAdjacentHTML("afterbegin", "<p class=\"quiz-selector-error\">Unable to load that quiz. Please try again.</p>");
        }
      });
    });
  };
  chooseQuizButton?.addEventListener("click", async () => {
    if (!quizSelector) return;
    quizSelector.hidden = false;
    if (quizSelectorGrid) quizSelectorGrid.innerHTML = "<p class=\"admin-live-note\">Loading quizzes...</p>";
    try {
      const response = await fetch("/api/lobby/quizzes");
      if (!response.ok) throw new Error("Unable to load quizzes");
      const data = await response.json();
      renderQuizCards(data.quizzes || []);
    } catch (error) {
      if (quizSelectorGrid) quizSelectorGrid.innerHTML = "<p class=\"quiz-selector-error\">Unable to load the quiz library.</p>";
    }
  });
  quizSelectorClose?.addEventListener("click", closeQuizSelector);
  quizSelector?.addEventListener("click", (event) => { if (event.target === quizSelector) closeQuizSelector(); });

  const createQuizButton = document.querySelector("[data-create-quiz]");
  const quizCreator = document.querySelector("[data-quiz-creator]");
  const quizCreatorClose = document.querySelector("[data-quiz-creator-close]");
  const quizCreatorForm = document.querySelector("[data-quiz-creator-form]");
  const quizCreatorQuestions = document.querySelector("[data-quiz-creator-questions]");
  const quizCreatorError = document.querySelector("[data-quiz-creator-error]");
  let quizQuestionIndex = 0;
  const addQuizQuestion = () => {
    if (!quizCreatorQuestions) return;
    const index = quizQuestionIndex++;
    quizCreatorQuestions.insertAdjacentHTML("beforeend", `<fieldset class="quiz-creator-question"><legend>Question ${index + 1}</legend><textarea name="question_${index}" placeholder="Question text" rows="2" required></textarea><div class="quiz-creator-answer-grid">${["a", "b", "c", "d"].map((letter) => `<label><input type="radio" name="correct_${index}" value="${letter}"${letter === "a" ? " checked" : ""} /><span>Correct</span><input name="answer_${index}_${letter}" placeholder="Option ${letter.toUpperCase()}" required /></label>`).join("")}</div></fieldset>`);
  };
  const closeQuizCreator = () => {
    if (quizCreator) quizCreator.hidden = true;
  };
  createQuizButton?.addEventListener("click", () => {
    if (!quizCreator) return;
    quizCreator.hidden = false;
    if (!quizCreatorQuestions?.children.length) addQuizQuestion();
  });
  document.querySelector("[data-add-quiz-question]")?.addEventListener("click", addQuizQuestion);
  quizCreatorClose?.addEventListener("click", closeQuizCreator);
  quizCreator?.addEventListener("click", (event) => { if (event.target === quizCreator) closeQuizCreator(); });
  quizCreatorForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (quizCreatorError) quizCreatorError.hidden = true;
    const formData = new FormData(quizCreatorForm);
    const questions = [...quizCreatorQuestions.querySelectorAll(".quiz-creator-question")].map((question, index) => ({
      text: formData.get(`question_${index}`),
      answer_a: formData.get(`answer_${index}_a`),
      answer_b: formData.get(`answer_${index}_b`),
      answer_c: formData.get(`answer_${index}_c`),
      answer_d: formData.get(`answer_${index}_d`),
      correct: formData.get(`correct_${index}`),
    }));
    const saveButton = quizCreatorForm.querySelector("[type=submit]");
    saveButton.disabled = true;
    try {
      const response = await fetch("/api/lobby/quizzes", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ title: formData.get("title"), questions }) });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || "Unable to save quiz.");
      closeQuizCreator();
      chooseQuizButton?.click();
    } catch (error) {
      if (quizCreatorError) {
        quizCreatorError.textContent = error.message;
        quizCreatorError.hidden = false;
      }
    } finally {
      saveButton.disabled = false;
    }
  });

  const exitModal = document.getElementById("lobby-exit-modal");
  if (exitModal && lobbyPhase) {
    let pendingHref = null;
    const showExitModal = (href) => { pendingHref = href; exitModal.hidden = false; };
    const hideExitModal = () => { pendingHref = null; exitModal.hidden = true; };
    document.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const anchor = event.target.closest("a[href]");
      if (!anchor || exitModal.contains(anchor)) return;
      if (anchor.target && anchor.target !== "_self") return;
      const href = anchor.getAttribute("href");
      if (!href || href.startsWith("#") || href.startsWith("/lobby")) return;
      event.preventDefault();
      showExitModal(anchor.href);
    });
    exitModal.querySelector("[data-lobby-exit-confirm]").addEventListener("click", () => {
      if (pendingHref) window.location.href = pendingHref;
    });
    exitModal.querySelector("[data-lobby-exit-cancel]").addEventListener("click", hideExitModal);
    exitModal.addEventListener("click", (event) => { if (event.target === exitModal) hideExitModal(); });
  }
</script>
