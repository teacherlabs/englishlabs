<main class="account-page">
  <section class="profile-card student-profile-card">
    <a class="back-link" href="/teacher/dashboard">← All students</a>
    <p class="eyebrow">Student profile</p>
    <div class="student-profile-identity"><canvas class="student-character-preview" data-student-character="{{student.username}}" width="96" height="96" aria-label="Student character"></canvas><div><h1 class="student-profile-name">{{#if student.fname}}{{student.fname}} {{student.lname}}{{else}}{{student.username}}{{/if}}</h1>
    <p class="student-username">@{{student.username}}</p></div></div>

    <div class="student-profile-layout">
      <aside class="student-profile-nav" aria-label="Student profile sections">
        <p class="exercise-overview-title">Profile sections</p>
        <button class="student-section-link active" type="button" data-student-section="activity-section">Activity performance</button>
        <button class="student-section-link" type="button" data-student-section="listening-section">Listening comprehension <span class="section-count">{{listeningCompletions.length}}</span></button>
        <button class="student-section-link" type="button" data-student-section="flip-section">Flip-card progress</button>
        <button class="student-section-link" type="button" data-student-section="chunks-section">Useful Chunk sentences <span class="section-count">{{usefulChunkSubmissionCount}}</span></button>
      </aside>

      <div class="student-profile-sections">
        <section class="student-profile-section active" id="activity-section" data-student-panel>
          <div class="student-section-heading">
            <div><p class="eyebrow">Learning goal</p><strong class="student-goal">{{#if student.goal}}{{student.goal}}{{else}}No goal set{{/if}}</strong></div>
          </div>
          <h2>Activity performance</h2>
          <div class="student-stats">
            {{#each activityStats}}
              <article><strong>{{activity_type}}</strong><b>{{points}} / {{possible_points}}</b><span>Average {{average_score}}% · Levels: {{#if levels}}{{levels}}{{else}}-{{/if}}</span></article>
            {{else}}
              <p class="empty-state">No completed activities yet.</p>
            {{/each}}
          </div>
        </section>

        <section class="student-profile-section" id="listening-section" data-student-panel hidden>
          <h2>Listening comprehension</h2>
          <div class="student-stats">
            {{#each listeningCompletions}}
              <article><strong>{{title}} - Exercise {{exerciseNumber}}</strong><b>{{points}} / {{total_points}}</b><span>{{percentage}}% · Completed {{completed_at}}</span></article>
            {{else}}
              <p class="empty-state">No completed listening exercises yet.</p>
            {{/each}}
          </div>
        </section>

        <section class="student-profile-section" id="flip-section" data-student-panel hidden>
          <h2>Flip-card progress</h2>
          <div class="flip-levels"><span class="{{#if flipCompletions.[0]}}completed{{/if}}">Easy{{#if flipCompletions.[0]}} completed{{else}} not completed{{/if}}</span><span class="{{#if flipCompletions.[1]}}completed{{/if}}">Medium{{#if flipCompletions.[1]}} completed{{else}} not completed{{/if}}</span></div>
          <h3>Hardest words</h3>
          {{#if hardestWords}}
            <ol class="admin-hardest-words">{{#each hardestWords}}<li><strong>{{word}}</strong></li>{{/each}}</ol>
          {{else}}
            <p class="empty-state">No skipped words yet.</p>
          {{/if}}
        </section>

        <section class="student-profile-section" id="chunks-section" data-student-panel hidden>
          <h2>Useful Chunk sentences</h2>
          <p class="student-section-summary">{{usefulChunkSubmissionCount}} saved sentence submissions</p>
          <div class="admin-chunk-lists">
            {{#each usefulChunkListsForAdmin}}
              <details class="admin-chunk-list">
                <summary><strong>List {{number}}</strong><span>{{submittedCount}} / {{totalCount}} completed</span></summary>
                <div class="admin-chunk-statuses">
                  {{#each chunks}}
                    <article class="admin-chunk-status{{#if submitted}} submitted{{/if}}"><div><strong>{{chunk}}</strong><span>{{#if submitted}}Submitted{{else}}Not submitted{{/if}}</span></div>{{#if submitted}}<p>{{sentence}}</p><small>{{submitted_at}}</small>{{/if}}</article>
                  {{/each}}
                </div>
              </details>
            {{/each}}
          </div>
        </section>
      </div>
    </div>
  </section>
</main>

<script>
  const studentSectionLinks = document.querySelectorAll("[data-student-section]");
  const studentPanels = document.querySelectorAll("[data-student-panel]");
  studentSectionLinks.forEach((link) => {
    link.addEventListener("click", () => {
      studentSectionLinks.forEach((item) => item.classList.toggle("active", item === link));
      studentPanels.forEach((panel) => {
        const isActive = panel.id === link.dataset.studentSection;
        panel.hidden = !isActive;
        panel.classList.toggle("active", isActive);
      });
    });
  });
</script>

<script>
  const characterCanvas = document.querySelector("[data-student-character]");
  if (characterCanvas) {
    const characterContext = characterCanvas.getContext("2d");
    const characterBase = "https://liberatedpixelcup.github.io/Universal-LPC-Spritesheet-Character-Generator/";
    const characterUser = encodeURIComponent(characterCanvas.dataset.studentCharacter);
    const loadCharacterImage = (spritePath) => new Promise((resolve, reject) => {
      const image = new Image();
      image.crossOrigin = "anonymous";
      image.onload = () => resolve(image);
      image.onerror = reject;
      image.src = `${characterBase}spritesheets/${spritePath}`;
    });
    const fallbackCharacterPaths = () => [
      "body/bodies/male/walk.png",
      "head/heads/human/male/walk.png",
      "head/faces/male/neutral/walk.png",
    ];
    fetch(`/api/profile/${characterUser}/character`)
      .then((response) => response.ok ? response.json() : null)
      .then((character) => {
        const savedLayers = character && Array.isArray(character.layers)
          ? character.layers.filter((layer) => typeof layer.spritePath === "string")
          : [];
        const paths = savedLayers.length
          ? savedLayers.sort((first, second) => first.zPos - second.zPos).map((layer) => layer.spritePath)
          : fallbackCharacterPaths();
        return Promise.all(paths.map((spritePath) => loadCharacterImage(spritePath)));
      })
      .then((images) => {
        if (!images || !characterContext) return;
        characterContext.clearRect(0, 0, characterCanvas.width, characterCanvas.height);
        images.forEach((image) => characterContext.drawImage(image, 0, 128, 64, 64, 16, 8, 64, 64));
      })
      .catch(() => {});
  }
</script>
