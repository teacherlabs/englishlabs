<main class="account-page">
  <div
    class="profile-layout"
    data-user-id="{{student.id}}"
    style="--profile-card-bg: {{student.profile_background}}; --profile-card-text: {{student.profile_text_color}}; --profile-card-muted: {{student.profile_muted_color}}; --profile-card-button-bg: {{student.profile_button_color}}; --profile-card-button-text: {{student.profile_button_text_color}}; --profile-progress-fill: {{student.profile_button_color}};"
  >
    <aside class="profile-messages-panel">
      <button class="profile-messages-toggle" type="button" data-profile-messages-toggle aria-expanded="false" aria-controls="profileMessagesContent">
        <span>Messages</span>
        {{#if unreadFeedbackCount}}<span class="profile-message-badge">{{unreadFeedbackCount}}</span>{{/if}}
        <span class="profile-messages-toggle-arrow" aria-hidden="true">›</span>
      </button>
      <div id="profileMessagesContent" class="profile-messages-content" data-profile-messages-content hidden>
        {{#each feedbackMessages}}
          <article class="profile-message{{#unless feedback_seen}} unread{{/unless}}">
            <strong>{{topic_title}}</strong>
            <p>{{feedback}}</p>
            <a class="profile-message-link" href="/writing/feedback/{{id}}/open">Go to exercise <span aria-hidden="true">→</span></a>
          </article>
        {{else}}
          <p class="empty-state">No teacher feedback yet.</p>
        {{/each}}
      </div>
    </aside>
    <section
      class="profile-card"
      style="--profile-card-bg: {{student.profile_background}}; --profile-card-text: {{student.profile_text_color}}; --profile-card-muted: {{student.profile_muted_color}}; --profile-card-button-bg: {{student.profile_button_color}}; --profile-card-button-text: {{student.profile_button_text_color}}; --profile-progress-fill: {{student.profile_button_color}};"
    >
      <div class="profile-heading">
        <div class="profile-identity">
          <div class="profile-avatar-wrap">
            {{#if student.avatar}}<img
                class="profile-avatar"
                src="{{student.avatarUrl}}"
                alt="Profile picture"
                data-avatar-initial="{{student.avatar_initial}}"
              />{{else if student.spritesheet}}<img
                class="profile-avatar"
                src="{{student.avatarUrl}}"
                alt="Profile picture"
                data-avatar-initial="{{student.avatar_initial}}"
              />{{else}}<div
                class="profile-avatar profile-avatar-placeholder"
                aria-label="Profile picture placeholder"
              >{{student.avatar_initial}}</div>{{/if}}
          </div>
          <div class="profile-copy"><p class="eyebrow">Student profile</p><h1
            >{{student.username}}</h1><p class="profile-email">{{student.email}}</p><div class="profile-goal-row">{{#if
                student.goal
              }}<p class="profile-goal">{{student.goal}}</p>{{/if}}<button
                class="goal-edit-button"
                type="button"
                data-goal-edit
                aria-label="Edit learning goal"
                title="Edit learning goal"
              >&#9998;</button></div></div>
        </div>
        <a class="practice-button" href="/logout">Log out</a>
      </div>
      <section class="character-settings" aria-labelledby="character-heading">
        <button class="character-settings-toggle" type="button" data-character-settings-toggle aria-expanded="false" aria-controls="characterSettingsContent">
          <span id="character-heading">{{#if isAdmin}}Create your teacher character{{else}}Create your character{{/if}}</span>
          <span class="character-settings-toggle-arrow" aria-hidden="true">›</span>
        </button>
        <div id="characterSettingsContent" class="character-settings-content" data-character-settings-content hidden>
          <p class="eyebrow">{{#if isAdmin}}Your teacher lobby identity{{else}}Your lobby identity{{/if}}</p>
          <p class="character-description">Choose a character to represent you when you join a lobby.</p>
          <button class="practice-button character-customize-button" type="button" data-character-open>Customize character</button>
          <p class="upload-success" data-character-saved hidden>Character saved to your profile.</p>
          <p class="account-error" data-character-error hidden></p>
        </div>
      </section>
      <dialog class="character-dialog" data-character-dialog>
        <button class="close-dialog" type="button" data-character-close aria-label="Close character creator">&#215;</button>
        <iframe
          class="character-generator-frame"
          id="character-creator-iframe"
          src="/character-generator"
          title="Character creator"
          loading="lazy"
        ></iframe>
      </dialog>
      <form
        class="goal-box goal-form"
        data-goal-settings
        action="/profile/goal"
        method="post"
        hidden
      ><label for="learningGoal">Learning goal</label><textarea
          id="learningGoal"
          name="goal"
          rows="2"
          placeholder="Write your own learning goal..."
        >{{student.goal}}</textarea><button
          class="notes-button"
          type="submit"
        >Save goal</button></form>
      {{#if query.goalSaved}}<p class="upload-success">Learning goal saved.</p>{{/if}}
      <h2>Progress overview</h2>
      <div class="profile-area-progress">
        {{#each areaProgress}}
          <div class="profile-area-progress-row"><div class="profile-area-progress-heading"><strong>{{label}}</strong><span>{{percentage}}% finished</span></div><div class="profile-progress-track" role="progressbar" aria-label="{{label}} progress" aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100"><span style="width: {{percentage}}%"></span></div></div>
        {{/each}}
      </div>
    </section>
  </div>
</main>
<script src="/js/character-spritesheet.js"></script>
<script>
  const profileMessagesToggle = document.querySelector("[data-profile-messages-toggle]");
  const profileMessagesContent = document.querySelector("[data-profile-messages-content]");
  const profileMessagesArrow = document.querySelector(".profile-messages-toggle-arrow");

  profileMessagesToggle?.addEventListener("click", () => {
    const willOpen = profileMessagesContent.hidden;
    profileMessagesContent.hidden = !willOpen;
    profileMessagesToggle.setAttribute("aria-expanded", String(willOpen));
    if (profileMessagesArrow) {
      profileMessagesArrow.style.transform = willOpen ? "rotate(90deg)" : "rotate(0deg)";
    }
  });

  const characterSettingsToggle = document.querySelector("[data-character-settings-toggle]");
  const characterSettingsContent = document.querySelector("[data-character-settings-content]");
  const characterSettingsArrow = document.querySelector(".character-settings-toggle-arrow");

  characterSettingsToggle?.addEventListener("click", () => {
    const willOpen = characterSettingsContent.hidden;
    characterSettingsContent.hidden = !willOpen;
    characterSettingsToggle.setAttribute("aria-expanded", String(willOpen));
    if (characterSettingsArrow) {
      characterSettingsArrow.style.transform = willOpen ? "rotate(90deg)" : "rotate(0deg)";
    }
  });

  const goalEditButton = document.querySelector("[data-goal-edit]");
  if (goalEditButton) {
    goalEditButton.addEventListener("click", () => {
      const settings = document.querySelector("[data-goal-settings]");
      if (settings) {
        settings.hidden = !settings.hidden;
      }
    });
  }

  const characterFrame = document.querySelector(".character-generator-frame");
  const characterDialog = document.querySelector("[data-character-dialog]");
  const characterOpen = document.querySelector("[data-character-open]");
  const characterClose = document.querySelector("[data-character-close]");
  const characterSaved = document.querySelector("[data-character-saved]");
  const characterError = document.querySelector("[data-character-error]");
  const profileUserId = document.querySelector(".profile-layout")?.dataset.userId || "unknown";
  const scopedCharacterKey = (name) => `${name}_${profileUserId}`;
  document.querySelectorAll("img[data-avatar-initial]").forEach((image) => {
    image.addEventListener("error", () => {
      const placeholder = document.createElement("div");
      placeholder.className = "profile-avatar profile-avatar-placeholder";
      placeholder.setAttribute("aria-label", "Profile picture placeholder");
      placeholder.textContent = image.dataset.avatarInitial || "?";
      image.replaceWith(placeholder);
    });
  });
  characterFrame?.addEventListener("load", () => {
    const savedConfig = localStorage.getItem(scopedCharacterKey("userCharacterConfig"));
    if (!savedConfig || !characterFrame.contentWindow) return;
    try {
      characterFrame.contentWindow.postMessage(
        { type: "LOAD_LPC_CHARACTER", payload: JSON.parse(savedConfig) },
        window.location.origin,
      );
    } catch (error) {
      localStorage.removeItem(scopedCharacterKey("userCharacterConfig"));
    }
  });
  characterOpen?.addEventListener("click", () => characterDialog?.showModal());
  characterClose?.addEventListener("click", () => characterDialog?.close());
  characterDialog?.addEventListener("click", (event) => {
    if (event.target === characterDialog) characterDialog.close();
  });
  window.addEventListener("message", (event) => {
    if (event.origin !== window.location.origin || event.source !== characterFrame?.contentWindow) return;
    if (event.data?.type !== "SAVE_LPC_CHARACTER") return;
    const payload = event.data.payload || {};
    const previewImage =
      payload.previewImage ||
      payload.preview ||
      payload.previewDataUrl ||
      payload.image ||
      payload.spritesheetImage;
    if (!previewImage) {
      if (characterError) { characterError.textContent = "The character generator did not send the character images."; characterError.hidden = false; }
      return;
    }
    window.bakeCharacterSpriteSheet(payload)
      .then((spritesheetImage) => {
        if (!spritesheetImage) throw new Error("The character generator did not send a sprite sheet.");
        const { layers, layerImages, spritesheetLayers, ...bakedPayload } = payload;
        return fetch("/api/profile/character", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...bakedPayload, previewImage, spritesheetImage }),
        }).then((response) =>
          response.json().then((result) => ({
            ok: response.ok,
            result,
            spritesheetImage,
          })),
        );
      })
      .then(({ ok, result, spritesheetImage }) => {
        if (!ok) throw new Error(result.error || "Unable to save character.");
        localStorage.setItem(scopedCharacterKey("userProfilePic"), previewImage);
        localStorage.setItem(scopedCharacterKey("userSpritesheet"), spritesheetImage);
        localStorage.setItem(scopedCharacterKey("userCharacterConfig"), JSON.stringify(payload.config || {}));
        if (!result.avatar) throw new Error("The server did not return the saved avatar.");
        const avatarUrl = result.avatar.startsWith("data:image/")
          ? result.avatar
          : `/uploads/profiles/${encodeURIComponent(result.avatar)}?t=${Date.now()}`;
        document.querySelectorAll(".profile-avatar, .nav-avatar").forEach((profileAvatar) => {
          if (profileAvatar.tagName === "IMG") profileAvatar.src = avatarUrl;
          else {
            const image = document.createElement("img");
            image.className = profileAvatar.classList.contains("nav-avatar") ? "nav-avatar" : "profile-avatar";
            image.src = avatarUrl;
            image.alt = "Profile picture";
            profileAvatar.replaceWith(image);
          }
        });
        if (characterSaved) characterSaved.hidden = false;
        if (characterError) characterError.hidden = true;
        characterDialog?.close();
      })
      .catch((error) => {
        if (characterError) { characterError.textContent = error.message; characterError.hidden = false; }
        if (characterSaved) characterSaved.hidden = true;
      });
  });
</script>