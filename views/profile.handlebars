<main class="account-page">
  <div
    class="profile-layout"
    data-user-id="{{student.id}}"
    style="--profile-card-bg: {{student.profile_background}}; --profile-card-text: {{student.profile_text_color}}; --profile-card-muted: {{student.profile_muted_color}}; --profile-card-button-bg: {{student.profile_button_color}}; --profile-card-button-text: {{student.profile_button_text_color}}; --profile-progress-fill: {{student.profile_button_color}};"
  >
    <aside class="profile-messages-panel">
      <div class="profile-messages-heading"><p class="eyebrow">Messages</p><h2>Teacher feedback{{#if unreadFeedbackCount}} <span class="profile-message-badge">{{unreadFeedbackCount}}</span>{{/if}}</h2></div>
      {{#each feedbackMessages}}
        <article class="profile-message{{#unless feedback_seen}} unread{{/unless}}">
          <strong>{{topic_title}}</strong>
          <p>{{feedback}}</p>
          <small>{{feedback_at}}</small>
          <a class="profile-message-link" href="/writing/feedback/{{id}}/open">Go to exercise <span aria-hidden="true">→</span></a>
        </article>
      {{else}}
        <p class="empty-state">No teacher feedback yet.</p>
      {{/each}}
    </aside>
    <section
      class="profile-card"
      style="--profile-card-bg: {{student.profile_background}}; --profile-card-text: {{student.profile_text_color}}; --profile-card-muted: {{student.profile_muted_color}}; --profile-card-button-bg: {{student.profile_button_color}}; --profile-card-button-text: {{student.profile_button_text_color}}; --profile-progress-fill: {{student.profile_button_color}};"
    >
      <div class="profile-heading">
        <div class="profile-identity">
          <div class="profile-avatar-wrap">
            {{#if student.avatar}}<img
                class="profile-avatar"
                src="/uploads/profiles/{{student.avatar}}"
                alt="Profile picture"
              />{{else}}<div
                class="profile-avatar profile-avatar-placeholder"
                aria-label="Profile picture placeholder"
              >{{student.avatar_initial}}</div>{{/if}}
            <button
              class="avatar-edit-button"
              type="button"
              data-avatar-edit
              aria-label="Change profile picture"
              title="Change profile picture"
            >&#9998;</button>
          </div>
          <div class="profile-copy"><p class="eyebrow">Student profile</p><h1
            >{{student.username}}</h1><div class="profile-goal-row">{{#if
                student.goal
              }}<p class="profile-goal">{{student.goal}}</p>{{/if}}<button
                class="goal-edit-button"
                type="button"
                data-goal-edit
                aria-label="Edit learning goal"
                title="Edit learning goal"
              >&#9998;</button></div></div>
        </div>
        <a class="practice-button" href="/logout">Log out</a>
      </div>
      <div class="avatar-settings" data-avatar-settings hidden>
        <form
          class="avatar-form"
          action="/profile/avatar"
          method="post"
          enctype="multipart/form-data"
        >
          <label for="profilePicture">Profile picture</label>
          <input
            id="profilePicture"
            name="profilePicture"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif"
            required
          />
          <small>PNG, JPG, WEBP or GIF. Maximum 2 MB.</small>
          <button class="notes-button" type="submit">Upload picture</button>
        </form>
        {{#if student.avatar}}{{/if}}
      </div>
      <section class="character-settings" aria-labelledby="character-heading">
        <div>
          <p class="eyebrow">{{#if isAdmin}}Your teacher lobby identity{{else}}Your lobby identity{{/if}}</p>
          <h2 id="character-heading">{{#if isAdmin}}Create your teacher character{{else}}Create your character{{/if}}</h2>
          <p class="character-description">Choose a character to represent you when you join a lobby.</p>
        </div>
        <button class="practice-button character-customize-button" type="button" data-character-open>Customize character</button>
        <p class="upload-success" data-character-saved hidden>Character saved to your profile.</p>
        <p class="account-error" data-character-error hidden></p>
      </section>
      <dialog class="character-dialog" data-character-dialog>
        <button class="close-dialog" type="button" data-character-close aria-label="Close character creator">&#215;</button>
        <iframe
          class="character-generator-frame"
          id="character-creator-iframe"
          src="/character-generator"
          title="Character creator"
          loading="lazy"
        ></iframe>
      </dialog>
      {{#if query.avatarSaved}}<p class="upload-success">Profile picture
          updated.</p>{{/if}}
      {{#if query.avatarError}}<p class="account-error">Please choose a valid
          image under 2 MB.</p>{{/if}}
      <form
        class="goal-box goal-form"
        data-goal-settings
        action="/profile/goal"
        method="post"
        hidden
      ><label for="learningGoal">Learning goal</label><textarea
          id="learningGoal"
          name="goal"
          rows="2"
          placeholder="Write your own learning goal..."
        >{{student.goal}}</textarea><button
          class="notes-button"
          type="submit"
        >Save goal</button></form>
      {{#if query.goalSaved}}<p class="upload-success">Learning goal saved.</p>{{/if}}
      <div class="profile-color-panel" data-profile-color-panel>
        <button
          class="profile-color-toggle"
          type="button"
          data-profile-color-toggle
          aria-expanded="false"
          aria-controls="profileBackgroundPanel"
        >
          <span>Profile background</span>
          <span class="profile-color-toggle-arrow" aria-hidden="true">›</span>
        </button>
        <form
          class="profile-color-form"
          id="profileBackgroundPanel"
          action="/profile/background"
          method="post"
          hidden
        >
          <label for="profileBackgroundColor">Choose a colour</label>
          <div class="profile-color-controls">
            <input
              id="profileBackgroundColor"
              name="profileBackgroundColor"
              type="color"
              value="{{student.profile_background}}"
              aria-label="Choose your profile background colour"
            />
            <button class="notes-button" type="submit">Save colour</button>
          </div>
        </form>
      </div>
      {{#if query.backgroundSaved}}<p class="upload-success">Profile background saved.</p>{{/if}}
      {{#if query.backgroundError}}<p class="account-error">Please choose a valid hex colour.</p>{{/if}}
      <h2>Progress overview</h2>
      <div class="profile-area-progress">
        {{#each areaProgress}}
          <div class="profile-area-progress-row"><div class="profile-area-progress-heading"><strong>{{label}}</strong><span>{{percentage}}% finished</span></div><div class="profile-progress-track" role="progressbar" aria-label="{{label}} progress" aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100"><span style="width: {{percentage}}%"></span></div></div>
        {{/each}}
      </div>
    </section>
  </div>
</main>
<script>
  const goalEditButton = document.querySelector("[data-goal-edit]");
  if (goalEditButton) {
    goalEditButton.addEventListener("click", () => {
      const settings = document.querySelector("[data-goal-settings]");
      if (settings) {
        settings.hidden = !settings.hidden;
      }
    });
  }

  const profileColorToggle = document.querySelector("[data-profile-color-toggle]");
  const profileBackgroundPanel = document.getElementById("profileBackgroundPanel");
  const profileColorArrow = document.querySelector(".profile-color-toggle-arrow");

  if (profileColorToggle && profileBackgroundPanel) {
    profileBackgroundPanel.hidden = true;
    profileColorToggle.setAttribute("aria-expanded", "false");
    profileColorToggle.addEventListener("click", () => {
      const willOpen = profileBackgroundPanel.hidden;
      profileBackgroundPanel.hidden = !willOpen;
      profileColorToggle.setAttribute("aria-expanded", String(willOpen));
      if (profileColorArrow) {
        profileColorArrow.style.transform = willOpen ? "rotate(90deg)" : "rotate(0deg)";
      }
    });
  }

  const profileColorInput = document.getElementById("profileBackgroundColor");
  const profileCard = document.querySelector(".profile-card");

  const setAccessibleProfileTheme = (hexColor) => {
    const safeColor = /^#[0-9a-fA-F]{6}$/.test(hexColor) ? hexColor : "#edf4ff";
    const value = safeColor.replace("#", "");
    const red = Number.parseInt(value.slice(0, 2), 16);
    const green = Number.parseInt(value.slice(2, 4), 16);
    const blue = Number.parseInt(value.slice(4, 6), 16);
    const luminance = (0.2126 * red + 0.7152 * green + 0.0722 * blue) / 255;
    const isLight = luminance > 0.72;

    const darken = (channel) =>
      Math.max(0, Math.round(channel * 0.78));
    const buttonColor = `#${darken(red).toString(16).padStart(2, "0")}${darken(green).toString(16).padStart(2, "0")}${darken(blue).toString(16).padStart(2, "0")}`;
    const progressFillColor = `#${darken(red).toString(16).padStart(2, "0")}${darken(green).toString(16).padStart(2, "0")}${darken(blue).toString(16).padStart(2, "0")}`;
    const buttonValue = buttonColor.replace("#", "");
    const buttonRed = Number.parseInt(buttonValue.slice(0, 2), 16);
    const buttonGreen = Number.parseInt(buttonValue.slice(2, 4), 16);
    const buttonBlue = Number.parseInt(buttonValue.slice(4, 6), 16);
    const buttonLuminance = (0.2126 * buttonRed + 0.7152 * buttonGreen + 0.0722 * buttonBlue) / 255;

    const textColor = isLight ? "#14213d" : "#f8fafc";
    const mutedColor = isLight ? "#475569" : "#dbeafe";
    const buttonTextColor = buttonLuminance > 0.72 ? "#14213d" : "#f8fafc";

    if (profileCard) {
      profileCard.style.setProperty("--profile-card-bg", safeColor);
      profileCard.style.setProperty("--profile-card-text", textColor);
      profileCard.style.setProperty("--profile-card-muted", mutedColor);
      profileCard.style.setProperty("--profile-card-button-bg", buttonColor);
      profileCard.style.setProperty("--profile-card-button-text", buttonTextColor);
      profileCard.style.setProperty("--profile-progress-fill", progressFillColor);
    }

    document.documentElement.style.setProperty("--profile-card-bg", safeColor);
    document.documentElement.style.setProperty("--profile-card-text", textColor);
    document.documentElement.style.setProperty("--profile-card-muted", mutedColor);
    document.documentElement.style.setProperty("--profile-card-button-bg", buttonColor);
    document.documentElement.style.setProperty("--profile-card-button-text", buttonTextColor);
    document.documentElement.style.setProperty("--profile-progress-fill", progressFillColor);
    document.documentElement.style.setProperty("--profile-nav-fill", safeColor);
    document.documentElement.style.setProperty("--profile-nav-text", textColor);
  };

  if (profileColorInput) {
    profileColorInput.addEventListener("input", (event) => {
      setAccessibleProfileTheme(event.target.value);
    });
  }

  if (profileColorInput) {
    setAccessibleProfileTheme(profileColorInput.value);
  }

  const characterFrame = document.querySelector(".character-generator-frame");
  const characterDialog = document.querySelector("[data-character-dialog]");
  const characterOpen = document.querySelector("[data-character-open]");
  const characterClose = document.querySelector("[data-character-close]");
  const characterSaved = document.querySelector("[data-character-saved]");
  const characterError = document.querySelector("[data-character-error]");
  const profileUserId = document.querySelector(".profile-layout")?.dataset.userId || "unknown";
  const scopedCharacterKey = (name) => `${name}_${profileUserId}`;
  characterFrame?.addEventListener("load", () => {
    const savedConfig = localStorage.getItem(scopedCharacterKey("userCharacterConfig"));
    if (!savedConfig || !characterFrame.contentWindow) return;
    try {
      characterFrame.contentWindow.postMessage(
        { type: "LOAD_LPC_CHARACTER", payload: JSON.parse(savedConfig) },
        window.location.origin,
      );
    } catch (error) {
      localStorage.removeItem(scopedCharacterKey("userCharacterConfig"));
    }
  });
  characterOpen?.addEventListener("click", () => characterDialog?.showModal());
  characterClose?.addEventListener("click", () => characterDialog?.close());
  characterDialog?.addEventListener("click", (event) => {
    if (event.target === characterDialog) characterDialog.close();
  });
  window.addEventListener("message", (event) => {
    if (event.origin !== window.location.origin || event.source !== characterFrame?.contentWindow) return;
    if (event.data?.type !== "SAVE_LPC_CHARACTER") return;
    const previewImage = event.data.payload?.previewImage || event.data.payload?.image || event.data.payload?.spritesheetImage;
    const spritesheetImage = event.data.payload?.spritesheetImage || event.data.payload?.image;
    if (!previewImage || !spritesheetImage) {
      if (characterError) { characterError.textContent = "The character generator did not send the character images."; characterError.hidden = false; }
      return;
    }
    fetch("/api/profile/character", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ ...event.data.payload, previewImage, spritesheetImage }),
    })
      .then((response) => response.json().then((result) => ({ ok: response.ok, result })))
      .then(({ ok, result }) => {
        if (!ok) throw new Error(result.error || "Unable to save character.");
        localStorage.setItem(scopedCharacterKey("userProfilePic"), previewImage);
        localStorage.setItem(scopedCharacterKey("userSpritesheet"), spritesheetImage);
        localStorage.setItem(scopedCharacterKey("userCharacterConfig"), JSON.stringify(event.data.payload?.config || {}));
        const avatarUrl = `/uploads/profiles/${result.avatar}?t=${Date.now()}`;
        document.querySelectorAll(".profile-avatar, .nav-avatar").forEach((profileAvatar) => {
          if (profileAvatar.tagName === "IMG") profileAvatar.src = avatarUrl;
          else {
            const image = document.createElement("img");
            image.className = profileAvatar.classList.contains("nav-avatar") ? "nav-avatar" : "profile-avatar";
            image.src = avatarUrl;
            image.alt = "Profile picture";
            profileAvatar.replaceWith(image);
          }
        });
        if (characterSaved) characterSaved.hidden = false;
        if (characterError) characterError.hidden = true;
        characterDialog?.close();
      })
      .catch((error) => {
        if (characterError) { characterError.textContent = error.message; characterError.hidden = false; }
        if (characterSaved) characterSaved.hidden = true;
      });
  });
</script>