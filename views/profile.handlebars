<main class="account-page">
  <div class="profile-layout">
    <section class="profile-card">
      <div class="profile-heading">
        <div class="profile-identity">
          <div class="profile-avatar-wrap">
            {{#if student.avatar}}<img
                class="profile-avatar"
                src="/uploads/profiles/{{student.avatar}}"
                alt="Profile picture"
              />{{else}}<div
                class="profile-avatar profile-avatar-placeholder"
                aria-label="Profile picture placeholder"
              >{{student.avatar_initial}}</div>{{/if}}
            <button
              class="avatar-edit-button"
              type="button"
              data-avatar-edit
              aria-label="Change profile picture"
              title="Change profile picture"
            >&#9998;</button>
          </div>
          <div class="profile-copy"><p class="eyebrow">Student profile</p><h1
            >{{student.username}}</h1><div class="profile-goal-row">{{#if
                student.goal
              }}<p class="profile-goal">{{student.goal}}</p>{{/if}}<button
                class="goal-edit-button"
                type="button"
                data-goal-edit
                aria-label="Edit learning goal"
                title="Edit learning goal"
              >&#9998;</button></div></div>
        </div>
        <a class="practice-button" href="/logout">Log out</a>
      </div>
      <div class="avatar-settings" data-avatar-settings hidden>
        <form
          class="avatar-form"
          action="/profile/avatar"
          method="post"
          enctype="multipart/form-data"
        >
          <label for="profilePicture">Profile picture</label>
          <input
            id="profilePicture"
            name="profilePicture"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif"
            required
          />
          <small>PNG, JPG, WEBP or GIF. Maximum 2 MB.</small>
          <button class="notes-button" type="submit">Upload picture</button>
        </form>
        {{#if student.avatar}}{{/if}}
      </div>
      {{#if query.avatarSaved}}<p class="upload-success">Profile picture
          updated.</p>{{/if}}
      {{#if query.avatarError}}<p class="account-error">Please choose a valid
          image under 2 MB.</p>{{/if}}
      <form
        class="goal-box goal-form"
        data-goal-settings
        action="/profile/goal"
        method="post"
        hidden
      ><label for="learningGoal">Learning goal</label><textarea
          id="learningGoal"
          name="goal"
          rows="2"
          placeholder="Write your own learning goal..."
        >{{student.goal}}</textarea><button
          class="notes-button"
          type="submit"
        >Save goal</button></form>
      {{#if query.goalSaved}}<p class="upload-success">Learning goal saved.</p>{{/if}}
      <div class="character-actions">
        <button id="open-character-editor" class="notes-button" type="button">Customize live</button>
        <a id="character-lobby-link" class="notes-button" href="/lobby">Enter lobby</a>
      </div>
      <h2>Progress overview</h2>
      <div class="profile-stats"><div><strong>{{stats.activities}}</strong><span
          >Activities</span></div><div><strong>{{stats.points}}</strong><span
          >Points earned</span></div><div><strong
          >{{stats.average_score}}%</strong><span>Average score</span></div></div>
    </section>
  </div>
</main>
<div id="character-editor-modal" class="character-editor-modal" hidden>
  <div class="character-editor-dialog" role="dialog" aria-modal="true" aria-labelledby="character-editor-title">
    <div class="character-editor-heading">
      <div><p class="eyebrow">Live character</p><h2 id="character-editor-title">Customize your explorer</h2></div>
      <button id="close-character-editor" class="modal-close" type="button" aria-label="Close character editor">&times;</button>
    </div>
    <iframe id="character-editor-frame" title="Live character editor"></iframe>
    <div class="editor-footer">
      <p id="editor-save-status" class="editor-save-note">Changes save automatically.</p>
      <button id="save-close-character-editor" class="notes-button" type="button">Save and close</button>
    </div>
  </div>
</div>
<script>
  const editorModal = document.getElementById("character-editor-modal");
  const editorFrame = document.getElementById("character-editor-frame");
  const editorSaveStatus = document.getElementById("editor-save-status");
  const editorBase = ["localhost", "127.0.0.1"].includes(window.location.hostname)
    ? "http://127.0.0.1:5173/"
    : "https://liberatedpixelcup.github.io/Universal-LPC-Spritesheet-Character-Generator/";
  let characterHash = "#sex=male";

  const saveCharacterHash = async (hash, layers = []) => {
    const response = await fetch("/api/profile/character", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ characterHash: hash, layers }),
    });
    if (!response.ok) throw new Error("Unable to save character");
  };

  fetch(`/api/profile/{{student.username}}/character`)
    .then((response) => response.ok ? response.json() : null)
    .then((character) => {
      if (!character) return;
      characterHash = `#${character.characterHash}`;
    });

  document.getElementById("open-character-editor").addEventListener("click", () => {
    editorFrame.src = `${editorBase}${characterHash}`;
    editorSaveStatus.textContent = "Changes save automatically.";
    editorModal.hidden = false;
  });
  const closeCharacterEditor = () => {
    editorModal.hidden = true;
    editorFrame.src = "about:blank";
  };
  document.getElementById("close-character-editor").addEventListener("click", () => {
    closeCharacterEditor();
  });
  document.getElementById("save-close-character-editor").addEventListener("click", () => {
    closeCharacterEditor();
  });
  editorModal.addEventListener("click", (event) => {
    if (event.target === editorModal) closeCharacterEditor();
  });
  window.addEventListener("message", async (event) => {
    if (event.origin !== new URL(editorBase).origin || !["lpc-character-hash", "lpc-character-state"].includes(event.data?.type)) return;
    try {
      await saveCharacterHash(event.data.hash, event.data.layers || []);
      characterHash = `#${event.data.hash}`;
      editorSaveStatus.textContent = "Saved to your profile.";
    } catch (error) {
      editorSaveStatus.textContent = "Could not save your character.";
    }
  });

  document.querySelector("[data-goal-edit]").addEventListener("click", () => {
  const settings = document.querySelector("[data-goal-settings]");
  settings.hidden = !settings.hidden; });
</script>