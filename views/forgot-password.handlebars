<main class="account-page">
  <section class="account-card">
    <p class="eyebrow">English Labs / Account</p>
    <h1>Forgot password?</h1>
    <p>Enter the email address connected to your student account.</p>
    <form action="/forgot-password" method="post" class="account-form" data-forgot-password-form>
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
      <button class="practice-button" type="submit">Send reset link</button>
    </form>
    <p class="{{#if error}}account-error{{else}}account-message{{/if}}" data-reset-status role="status" aria-live="polite"{{#unless error}}{{#unless message}} hidden{{/unless}}{{/unless}}>{{#if error}}{{error}}{{else}}{{message}}{{/if}}</p>
    <a class="account-link" href="/login">Back to log in</a>
  </section>
</main>
<script>
  const resetForm = document.querySelector("[data-forgot-password-form]");
  const resetStatus = document.querySelector("[data-reset-status]");
  if (resetForm && resetStatus) {
    resetForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = resetForm.querySelector("button[type='submit']");
      button.disabled = true;
      resetStatus.hidden = false;
      resetStatus.className = "account-message";
      resetStatus.textContent = "Sending reset link...";
      try {
        const response = await fetch(resetForm.action, {
          method: "POST",
          body: new FormData(resetForm),
          headers: { Accept: "text/html" },
        });
        if (!response.ok) throw new Error("Unable to send the reset link.");
        resetStatus.textContent = "Reset link sent! Please check your email";
      } catch (error) {
        resetStatus.className = "account-error";
        resetStatus.textContent = error.message;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>