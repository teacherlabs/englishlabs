<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>English Labs</title>
    <link rel="stylesheet" href="/css/style.css?v=20261003-rightbar-dock" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Teachers:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nerko+One&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caesar+Dressing&family=Google+Sans+Flex:opsz,wght@6..144,1..1000&family=Major+Mono+Display&family=Water+Brush&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {{#if session.isLoggedIn}}
      <div class="app-shell">
        <button
          class="app-menu-toggle"
          type="button"
          data-app-menu-toggle
          aria-label="Open main navigation"
          aria-controls="app-sidebar"
          aria-expanded="false"
        >
          <span></span><span></span><span></span>
        </button>
        <button
          class="app-nav-backdrop"
          type="button"
          data-app-nav-backdrop
          aria-label="Close main navigation"
          hidden
        ></button>
        <aside class="app-sidebar" id="app-sidebar" aria-label="Main navigation">
          <a class="app-brand" href="/">
            <img class="app-brand-logo" src="/logo.png" alt="English Labs logo" />
          </a>
          <nav class="app-nav" aria-label="Main navigation">
            <p class="app-nav-label">Workspace</p>
            {{#each appNavWorkspace}}<a href="{{href}}" class="app-nav-link{{#if active}} is-active{{/if}}"{{#if active}} aria-current="page"{{/if}}><span class="app-nav-icon">{{icon}}</span><span>{{label}}</span></a>{{/each}}
            <p class="app-nav-label app-nav-label-spaced">Practice together</p>
            {{#each appNavPractice}}<a href="{{href}}" class="app-nav-link{{#if active}} is-active{{/if}}"{{#if active}} aria-current="page"{{/if}}><span class="app-nav-icon">{{icon}}</span><span>{{label}}</span></a>{{/each}}
          </nav>
          <div class="app-sidebar-footer">
            <div class="candle-sidebar-wrapper" style="display: flex; justify-content: center; padding: 10px 0;">
              <div class="rpg-candle-container" id="rpgCandle">
                <div class="candle-glow"></div>
                <span class="candle-tooltip candle-tooltip-light">Light</span>
                <span class="candle-tooltip candle-tooltip-extinguish">Extinguish</span>
                <div class="candle-holder">
                  <div class="candle-body">
                    <div class="candle-wick"></div>
                    <div class="candle-flame"></div>
                  </div>
                  <div class="candle-base"></div>
                </div>
              </div>
            </div>
            <a href="/profile" class="app-account-link">
              {{#if session.avatar}}<img src="{{session.avatarUrl}}" alt="" class="app-avatar profile-avatar-img" />{{else}}<span class="app-avatar app-avatar-placeholder">{{session.avatar_initial}}</span>{{/if}}
              <span><strong>{{session.name}}</strong><small>{{#if session.isAdmin}}Teacher account{{else}}Student account{{/if}}</small></span>
            </a>
            <a href="/logout" class="app-logout-link">Log out</a>
          </div>
        </aside>
        <div class="app-main">{{{body}}}</div>
        <aside class="app-rightbar" aria-label="Profile and progress">
          <div class="app-profile-card">
            <a class="app-profile-card-link" href="/profile" aria-label="Open {{session.name}}'s profile">
              <span class="app-profile-card-heading"><span class="app-rail-label">Your space</span><span class="app-profile-card-arrow" aria-hidden="true">↗</span></span>
              {{#if session.avatar}}<img src="{{session.avatarUrl}}" alt="{{session.name}}'s character" class="app-profile-avatar profile-avatar-img" />{{else}}<span class="app-profile-avatar app-avatar-placeholder">{{session.avatar_initial}}</span>{{/if}}
              <h2>{{session.name}}</h2>
              {{#unless session.isAdmin}}<p>{{#if dashboardGoal}}{{dashboardGoal}}{{else}}No learning goal set yet.{{/if}}</p>{{/unless}}
            </a>
            {{#if session.isAdmin}}<button class="app-character-link practice-button" type="button" data-teacher-character-open>Customize character <span aria-hidden="true">→</span></button>{{/if}}
          </div>
          {{#if dashboardSchedule}}
            <section class="app-calendar-card" aria-labelledby="calendar-heading">
              <div class="app-widget-heading"><div><p class="app-rail-label">Plan ahead</p><h2 id="calendar-heading">{{dashboardSchedule.monthLabel}}</h2></div><span class="app-calendar-icon" aria-hidden="true">▦</span></div>
              <div class="app-calendar-grid app-calendar-weekdays" aria-hidden="true">
                {{#each dashboardSchedule.weekdays}}<span>{{this}}</span>{{/each}}
              </div>
              <div class="app-calendar-grid app-calendar-days">
                {{#each dashboardSchedule.calendarWeeks}}
                  {{#each this}}<span class="app-calendar-day{{#unless isCurrentMonth}} is-muted{{/unless}}{{#if isToday}} is-today{{/if}}{{#if isHighlighted}} has-reminder{{/if}}"{{#if isToday}} aria-current="date"{{/if}}>{{number}}{{#if isHighlighted}}<i aria-hidden="true"></i>{{/if}}</span>{{/each}}
                {{/each}}
              </div>
            </section>
          {{/if}}
          {{#if studentRemindersLoaded}}
            <section class="app-reminders-card" aria-labelledby="reminders-heading">
              <div class="app-widget-heading"><p class="app-rail-label" id="reminders-heading">Reminders</p><span class="app-reminder-count">{{studentReminders.length}}</span></div>
              <div class="app-reminders-list app-student-reminders">
                {{#each studentReminders}}
                    <article class="app-reminder app-student-reminder" data-reminder-id="{{id}}">
                    {{#if target_route}}<a class="app-reminder-link" href="{{target_route}}">{{else}}<span class="app-reminder-link">{{/if}}
                      <span class="app-reminder-date"><strong>{{dueDay}}</strong><small>{{dueMonth}}</small></span>
                      <span class="app-reminder-copy"><strong>{{message}}</strong></span>
                    {{#if target_route}}</a>{{else}}</span>{{/if}}
                    <span class="app-reminder-category">{{category}}</span>
                    <button class="app-reminder-done" type="button" data-complete-reminder="{{id}}" aria-label="Mark reminder done">✓</button>
                    <button class="app-reminder-dismiss" type="button" data-delete-reminder="{{id}}" aria-label="Delete reminder">×</button>
                  </article>
                {{else}}
                  <p class="app-reminder-empty">No reminders yet.</p>
                {{/each}}
              </div>
            </section>
          {{/if}}
          {{#if unreadFeedbackCount}}
            <a href="/profile" class="app-feedback-card"><span class="app-feedback-count">{{unreadFeedbackCount}}</span><span><strong>New feedback</strong><small>Open your teacher messages</small></span><span aria-hidden="true">→</span></a>
          {{/if}}
        </aside>
        {{#if session.isAdmin}}
          <dialog class="character-dialog" data-teacher-character-dialog aria-labelledby="teacher-character-title">
            <h2 class="visually-hidden" id="teacher-character-title">Customize your character</h2>
            <button class="close-dialog" type="button" data-teacher-character-close aria-label="Close character customization">&#215;</button>
            <p class="character-generator-error" data-teacher-character-error role="alert" hidden></p>
            <iframe
              class="character-generator-frame"
              src="/character-generator?embed=1"
              title="Teacher character customization"
              loading="lazy"
            ></iframe>
          </dialog>
        {{/if}}
      </div>
      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const menuToggle = document.querySelector("[data-app-menu-toggle]");
          const sidebar = document.querySelector("#app-sidebar");
          const menuBackdrop = document.querySelector("[data-app-nav-backdrop]");
          const mobileNavigation = window.matchMedia("(max-width: 768px)");
          const setMenuOpen = (isOpen, returnFocus = false) => {
            if (!menuToggle || !sidebar || !menuBackdrop) return;
            const shouldOpen = isOpen && mobileNavigation.matches;
            document.querySelector(".app-shell")?.classList.toggle("is-nav-open", shouldOpen);
            menuToggle.setAttribute("aria-expanded", String(shouldOpen));
            menuToggle.setAttribute(
              "aria-label",
              shouldOpen ? "Close main navigation" : "Open main navigation",
            );
            menuBackdrop.hidden = !shouldOpen;
            document.body.classList.toggle("app-nav-open", shouldOpen);
            if (shouldOpen) {
              sidebar.querySelector(".app-nav-link")?.focus();
            } else if (returnFocus) {
              menuToggle.focus();
            }
          };

          menuToggle?.addEventListener("click", () => {
            setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
          });
          menuBackdrop?.addEventListener("click", () => setMenuOpen(false));
          sidebar?.addEventListener("click", (event) => {
            if (event.target.closest("a")) setMenuOpen(false);
          });
          document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
              setMenuOpen(false, true);
            }
          });
          mobileNavigation.addEventListener("change", (event) => {
            if (!event.matches) setMenuOpen(false);
          });

          const candle = document.getElementById("rpgCandle");
          if (candle) {
            const candleStorageKey = "rpgCandleLit";
            try {
              if (localStorage.getItem(candleStorageKey) === "true") {
                candle.classList.add("is-lit");
              }
            } catch (error) {
              console.warn("Unable to restore candle state.", error);
            }

            candle.addEventListener("click", () => {
              candle.classList.toggle("is-lit");
              try {
                localStorage.setItem(
                  candleStorageKey,
                  String(candle.classList.contains("is-lit")),
                );
              } catch (error) {
                console.warn("Unable to save candle state.", error);
              }
            });
          }
        });

        document.querySelectorAll("[data-complete-reminder]").forEach((button) => {
          button.addEventListener("click", async () => {
            if (!window.confirm("Mark this reminder as done?")) return;
            button.disabled = true;
            try {
              const response = await fetch(`/api/reminders/${button.dataset.completeReminder}/complete`, {
                method: "POST",
                headers: { Accept: "application/json" },
              });
              if (!response.ok) throw new Error("complete failed");
              button.closest("[data-reminder-id]")?.remove();
              const count = document.querySelector("#reminders-heading + .app-reminder-count");
              if (count) count.textContent = document.querySelectorAll(".app-student-reminder").length;
            } catch (error) {
              button.disabled = false;
              window.alert("Unable to complete this reminder.");
            }
          });
        });

        document.querySelectorAll("[data-delete-reminder]").forEach((button) => {
          button.addEventListener("click", async () => {
            if (!window.confirm("Are you sure you want to delete this reminder?")) return;
            button.disabled = true;
            try {
              const response = await fetch(`/api/reminders/${button.dataset.deleteReminder}`, {
                method: "DELETE",
                headers: { Accept: "application/json" },
              });
              if (!response.ok) throw new Error("delete failed");
              button.closest("[data-reminder-id]")?.remove();
              const count = document.querySelector("#reminders-heading + .app-reminder-count");
              if (count) count.textContent = document.querySelectorAll(".app-student-reminder").length;
            } catch (error) {
              button.disabled = false;
              window.alert("Unable to delete this reminder.");
            }
          });
        });
      </script>
      {{#if session.isAdmin}}
        <script>
          (() => {
            const dialog = document.querySelector("[data-teacher-character-dialog]");
            const openButton = document.querySelector("[data-teacher-character-open]");
            const closeButton = document.querySelector("[data-teacher-character-close]");
            const errorMessage = document.querySelector("[data-teacher-character-error]");
            const characterFrame = dialog?.querySelector("iframe");
            openButton?.addEventListener("click", () => {
              errorMessage.hidden = true;
              dialog?.showModal();
            });
            closeButton?.addEventListener("click", () => dialog?.close());
            dialog?.addEventListener("click", (event) => {
              if (event.target === dialog) dialog.close();
            });
            window.addEventListener("message", (event) => {
              if (
                event.origin !== window.location.origin ||
                event.source !== characterFrame?.contentWindow
              ) return;
              if (event.data?.type === "TEACHER_CHARACTER_SAVE_FAILED") {
                errorMessage.textContent = event.data.message || "Unable to save the character.";
                errorMessage.hidden = false;
                return;
              }
              if (event.data?.type !== "TEACHER_CHARACTER_SAVED") return;
              const { avatar, spritesheet, username } = event.data.payload || {};
              if (!avatar || !spritesheet || !username) return;
              errorMessage.hidden = true;
              const avatarUrl = avatar.startsWith("data:image/")
                ? avatar
                : `/uploads/profiles/${encodeURIComponent(avatar)}?t=${Date.now()}`;
              document.querySelectorAll(
                ".app-avatar, .app-profile-avatar, .profile-avatar, .dashboard-avatar",
              ).forEach((profileAvatar) => {
                if (profileAvatar.tagName === "IMG") {
                  profileAvatar.src = avatarUrl;
                  return;
                }
                if (!profileAvatar.classList.contains("app-avatar-placeholder")) return;
                const image = document.createElement("img");
                image.className = profileAvatar.className
                  .replace("app-avatar-placeholder", "")
                  .trim();
                image.src = avatarUrl;
                image.alt = `${username}'s character`;
                profileAvatar.replaceWith(image);
              });
              try {
                localStorage.setItem(`userProfilePic_${username}`, avatar);
                localStorage.setItem(`userSpritesheet_${username}`, spritesheet);
                localStorage.setItem(
                  `userCharacterConfig_${username}`,
                  JSON.stringify(event.data.payload.config || {}),
                );
              } catch (error) {
                console.warn("Unable to cache the saved teacher character.", error);
              }
              dialog?.close();
            });
          })();
        </script>
      {{/if}}
    {{else}}
      <header><nav><ul></ul></nav></header>
      {{{body}}}
    {{/if}}
  </body>
</html>