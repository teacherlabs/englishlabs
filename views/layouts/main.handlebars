<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>English Labs</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Teachers:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nerko+One&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caesar+Dressing&family=Google+Sans+Flex:opsz,wght@6..144,1..1000&family=Major+Mono+Display&family=Water+Brush&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <nav>
        <ul>
          {{#if session.isLoggedIn}}<li><a href="/">Grammar</a></li>
          <li><a href="/reading">Reading</a></li>
          <li><a href="/listening">Listening</a></li>
          <li><a href="/writing">Writing</a></li>
          <li><a href="/vocabulary/flip-cards">Vocabulary</a></li>{{/if}}
          {{#if session.isLoggedIn}}
            <li class="game-room-nav">
              <span>Game Room</span>
              <div class="game-room-nav-options">
                <a href="/lobby?mode=quicktype">Quicktype</a>
                <a href="/lobby?mode=lobby">Lobby</a>
              </div>
            </li>
          {{/if}}
        </ul>
        {{#if session.isLoggedIn}}
          <div id="menulogin" class="user-profile-menu">
            <span>Hi, {{session.name}}</span>

            <!-- Profile Picture Link Placeholder -->
            <a href="{{#if session.isAdmin}}/teacher/dashboard{{else}}/profile{{/if}}" class="profile-pic-link" title="{{#if session.isAdmin}}Teacher dashboard{{else}}View Profile{{/if}}">
              {{#if session.avatar}}
                <img src="/uploads/profiles/{{session.avatar}}" alt="Profile Picture" class="nav-avatar" />
              {{else}}
                <span class="nav-avatar nav-avatar-placeholder" aria-label="Profile picture placeholder">{{session.avatar_initial}}</span>
              {{/if}}
              {{#unless session.isAdmin}}{{#if unreadFeedbackCount}}<span class="nav-feedback-badge" aria-label="{{unreadFeedbackCount}} unread teacher feedback">{{unreadFeedbackCount}}</span>{{/if}}{{/unless}}
            </a>

            <a href="/logout" class="login-btn">Log out</a>
          </div>
        {{else}}
          <div class="auth-button">
            <a href="/login" class="login-btn">Log in</a>
            <a href="/signup" class="signup-btn">Sign up</a>
          </div>
        {{/if}}
      </nav>
    </header>
    {{{body}}}
  </body>
</html>