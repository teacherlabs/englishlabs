<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>English Labs</title>
    <link rel="stylesheet" href="/css/style.css?v=20260910-dashboard-notifications" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Teachers:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nerko+One&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caesar+Dressing&family=Google+Sans+Flex:opsz,wght@6..144,1..1000&family=Major+Mono+Display&family=Water+Brush&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {{#if session.isLoggedIn}}
      <div class="app-shell">
        <aside class="app-sidebar">
          <a class="app-brand" href="/">
            <span class="app-brand-mark">EL</span>
            <span>English Labs</span>
            <small>Learning studio</small>
          </a>
          <nav class="app-nav" aria-label="Main navigation">
            <p class="app-nav-label">Workspace</p>
            <a href="/" class="app-nav-link"><span class="app-nav-icon">01</span>Dashboard</a>
            <a href="/practice/questions" class="app-nav-link"><span class="app-nav-icon">02</span>Grammar</a>
            <a href="/vocabulary/flip-cards" class="app-nav-link"><span class="app-nav-icon">03</span>Vocabulary</a>
            <a href="/reading" class="app-nav-link"><span class="app-nav-icon">04</span>Reading</a>
            <a href="/writing" class="app-nav-link"><span class="app-nav-icon">05</span>Writing</a>
            <a href="/listening" class="app-nav-link"><span class="app-nav-icon">06</span>Listening</a>
            <p class="app-nav-label app-nav-label-spaced">Practice together</p>
            <a href="/lobby" class="app-nav-link"><span class="app-nav-icon">07</span>Lobby</a>
            <a href="/quicktype" class="app-nav-link"><span class="app-nav-icon">08</span>QuickType</a>
            <a href="/question-game" class="app-nav-link"><span class="app-nav-icon">09</span>Question game</a>
            {{#if session.isAdmin}}<a href="/teacher/dashboard" class="app-nav-link"><span class="app-nav-icon">10</span>Students</a>{{/if}}
          </nav>
          <div class="app-sidebar-footer">
            <a href="/profile" class="app-account-link">
              {{#if session.avatar}}<img src="{{session.avatarUrl}}" alt="" class="app-avatar" />{{else}}<span class="app-avatar app-avatar-placeholder">{{session.avatar_initial}}</span>{{/if}}
              <span><strong>{{session.name}}</strong><small>{{#if session.isAdmin}}Teacher account{{else}}Student account{{/if}}</small></span>
            </a>
            <a href="/logout" class="app-logout-link">Log out</a>
          </div>
        </aside>
        <div class="app-main">{{{body}}}</div>
        <aside class="app-rightbar" aria-label="Profile and progress">
          <div class="app-profile-card">
            <div class="app-profile-card-heading"><p class="app-rail-label">Your space</p><a href="/profile" aria-label="Open profile">↗</a></div>
            {{#if session.avatar}}<img src="{{session.avatarUrl}}" alt="{{session.name}}'s character" class="app-profile-avatar" />{{else}}<span class="app-profile-avatar app-avatar-placeholder">{{session.avatar_initial}}</span>{{/if}}
            <h2>{{session.name}}</h2>
            <p>Build your English practice rhythm.</p>
          </div>
          {{#unless session.isAdmin}}
            <div class="app-progress-card">
              <p class="app-rail-label">Learning pulse</p>
              <div class="app-pulse-row"><strong>Keep going</strong><span>Today</span></div>
              <div class="app-pulse-track"><span></span></div>
              <p class="app-pulse-note">Your activity and completed work live in your profile.</p>
              <a href="/profile" class="app-rail-link">View full progress <span>→</span></a>
            </div>
          {{/unless}}
          {{#if dashboardSchedule}}
            <section class="app-calendar-card" aria-labelledby="calendar-heading">
              <div class="app-widget-heading"><div><p class="app-rail-label">Plan ahead</p><h2 id="calendar-heading">{{dashboardSchedule.monthLabel}}</h2></div><span class="app-calendar-icon" aria-hidden="true">▦</span></div>
              <div class="app-calendar-grid app-calendar-weekdays" aria-hidden="true">
                {{#each dashboardSchedule.weekdays}}<span>{{this}}</span>{{/each}}
              </div>
              <div class="app-calendar-grid app-calendar-days">
                {{#each dashboardSchedule.calendarWeeks}}
                  {{#each this}}<span class="app-calendar-day{{#unless isCurrentMonth}} is-muted{{/unless}}{{#if isToday}} is-today{{/if}}{{#if isHighlighted}} has-reminder{{/if}}"{{#if isToday}} aria-current="date"{{/if}}>{{number}}{{#if isHighlighted}}<i aria-hidden="true"></i>{{/if}}</span>{{/each}}
                {{/each}}
              </div>
            </section>
          {{/if}}
          {{#if studentRemindersLoaded}}
            <section class="app-reminders-card" aria-labelledby="reminders-heading">
              <div class="app-widget-heading"><p class="app-rail-label" id="reminders-heading">Reminders</p><span class="app-reminder-count">{{studentReminders.length}}</span></div>
              <div class="app-reminders-list app-student-reminders">
                {{#each studentReminders}}
                    <article class="app-reminder app-student-reminder" data-reminder-id="{{id}}">
                    {{#if target_route}}<a class="app-reminder-link" href="{{target_route}}">{{else}}<span class="app-reminder-link">{{/if}}
                      <span class="app-reminder-date"><strong>{{dueDay}}</strong><small>{{dueMonth}}</small></span>
                      <span class="app-reminder-copy"><strong>{{message}}</strong></span>
                    {{#if target_route}}</a>{{else}}</span>{{/if}}
                    <span class="app-reminder-category">{{category}}</span>
                    <button class="app-reminder-done" type="button" data-complete-reminder="{{id}}" aria-label="Mark reminder done">✓</button>
                    <button class="app-reminder-dismiss" type="button" data-delete-reminder="{{id}}" aria-label="Delete reminder">×</button>
                  </article>
                {{else}}
                  <p class="app-reminder-empty">No reminders yet.</p>
                {{/each}}
              </div>
            </section>
          {{/if}}
          {{#if unreadFeedbackCount}}
            <a href="/profile" class="app-feedback-card"><span class="app-feedback-count">{{unreadFeedbackCount}}</span><span><strong>New feedback</strong><small>Open your teacher messages</small></span><span aria-hidden="true">→</span></a>
          {{/if}}
        </aside>
      </div>
      <script>
        document.querySelectorAll("[data-complete-reminder]").forEach((button) => {
          button.addEventListener("click", async () => {
            if (!window.confirm("Mark this reminder as done?")) return;
            button.disabled = true;
            try {
              const response = await fetch(`/api/reminders/${button.dataset.completeReminder}/complete`, {
                method: "POST",
                headers: { Accept: "application/json" },
              });
              if (!response.ok) throw new Error("complete failed");
              button.closest("[data-reminder-id]")?.remove();
              const count = document.querySelector("#reminders-heading + .app-reminder-count");
              if (count) count.textContent = document.querySelectorAll(".app-student-reminder").length;
            } catch (error) {
              button.disabled = false;
              window.alert("Unable to complete this reminder.");
            }
          });
        });

        document.querySelectorAll("[data-delete-reminder]").forEach((button) => {
          button.addEventListener("click", async () => {
            if (!window.confirm("Are you sure you want to delete this reminder?")) return;
            button.disabled = true;
            try {
              const response = await fetch(`/api/reminders/${button.dataset.deleteReminder}`, {
                method: "DELETE",
                headers: { Accept: "application/json" },
              });
              if (!response.ok) throw new Error("delete failed");
              button.closest("[data-reminder-id]")?.remove();
              const count = document.querySelector("#reminders-heading + .app-reminder-count");
              if (count) count.textContent = document.querySelectorAll(".app-student-reminder").length;
            } catch (error) {
              button.disabled = false;
              window.alert("Unable to delete this reminder.");
            }
          });
        });
      </script>
    {{else}}
      <header><nav><ul></ul></nav></header>
      {{{body}}}
    {{/if}}
  </body>
</html>